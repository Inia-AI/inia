            "cwd": "${workspaceFolder}/artifacts/bin/IniaAi.WebApi/debug/",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+http://\\S+:([0-9]+)",
                "uriFormat": "http://localhost:%s/swagger"
            },
            "launchSettingsFilePath": "${workspaceFolder}/IniaAi.WebApi/Properties/launchSettings.json",
            "launchSettingsProfile": "AWS API Postgres"
