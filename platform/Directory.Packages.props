<Project>
    <PropertyGroup>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.3" />
        <PackageVersion Include="Amazon.Extensions.Configuration.SystemsManager" Version="7.1.0" />
        <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1" />
        <PackageVersion Include="Ardalis.Specification" Version="9.3.1" />
        <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
        <PackageVersion Include="AutoFixture" Version="4.18.1" />
        <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.21.2" />
        <PackageVersion Include="AWSSDK.CloudWatch" Version="4.0.12.5" />
        <PackageVersion Include="AWSSDK.S3" Version="4.0.25.2" />
        <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.5.7" />
        <PackageVersion Include="AWSSDK.ServiceQuotas" Version="4.0.5.9" />
        <PackageVersion Include="AWSSDK.SimpleEmailV2" Version="4.0.14.8" />
        <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.0.8.7" />
        <PackageVersion Include="AWSSDK.SSO" Version="4.0.3.7" />
        <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.4.9" />
        <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
        <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
        <PackageVersion Include="Azure.Identity" Version="1.21.0" />
        <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.10.0" />
        <PackageVersion Include="bblanchon.PDFium.Linux" Version="158.0.8125" />
        <PackageVersion Include="bblanchon.PDFium.macOS" Version="158.0.8125" />
        <PackageVersion Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="bunit" Version="2.11.3" />
        <PackageVersion Include="ClosedXML" Version="0.105.1" />
        <PackageVersion Include="CodeBeam.MudBlazor.Extensions" Version="9.1.0" />
        <PackageVersion Include="Corvus.Text.Json.Validator" Version="5.8.0" />
        <PackageVersion Include="CsvHelper" Version="33.1.0" />
        <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="ErrorOr" Version="2.1.1" />
        <PackageVersion Include="ExcelNumberFormat" Version="1.1.0" />
        <PackageVersion Include="FileSignatures" Version="7.3.0" />
        <PackageVersion Include="Finbuckle.MultiTenant.AspNetCore" Version="10.1.1" />
        <PackageVersion Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="10.1.1" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageVersion Include="FluentValidation" Version="12.1.1" />
        <PackageVersion Include="google-search-results-dotnet" Version="2.0.1" />
        <PackageVersion Include="Google.Apis.Auth" Version="1.75.0" />
        <PackageVersion Include="Google.Apis.CustomSearchAPI.v1" Version="1.74.0.3520" />
        <PackageVersion Include="Google.Apis" Version="1.75.0" />
        <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
        <PackageVersion Include="HtmlToOpenXml.dll" Version="3.5.0" />
        <PackageVersion Include="ISO3166" Version="1.0.4" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
        <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
        <PackageVersion Include="Microsoft.ApplicationInsights" Version="3.1.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
        <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <!-- The Microsoft.IdentityModel libraries work only at one shared version. ASP.NET Core pulls
             this package at this version, and OpenIddict and Microsoft.Data.SqlClient pull older copies
             of the rest. IdentityModelVersionTests fails on a mismatch. -->
        <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="Microsoft.SemanticKernel" Version="1.77.0" />
        <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageVersion Include="MimeKit" Version="4.17.0" />
        <PackageVersion Include="Minio" Version="7.0.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="MudBlazor" Version="9.12.0" />
        <PackageVersion Include="MudBlazor.Markdown" Version="9.0.0" />
        <PackageVersion Include="NCalcSync" Version="6.2.0" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageVersion Include="NReco.Text.AhoCorasickDoubleArrayTrie" Version="1.1.1" />
        <PackageVersion Include="NSubstitute" Version="5.3.0" />
        <PackageVersion Include="OfficeIMO.Excel" Version="3.5.2" />
        <PackageVersion Include="OpenIddict.Client" Version="7.5.0" />
        <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
        <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.5.0" />
        <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.5.0" />
        <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.5.0" />
        <!-- Pin transitive from Microsoft.ApplicationInsights to stay at/above the
        propagation-header DoS fix (GHSA-g94r-2vxg-569j, patched in 1.15.3) -->
        <PackageVersion Include="OpenMcdf" Version="3.1.4" />
        <PackageVersion Include="OpenTelemetry.Api" Version="1.16.0" />
        <PackageVersion Include="Polly" Version="8.7.0" />
        <PackageVersion Include="Selenium.WebDriver" Version="4.45.0" />
        <PackageVersion Include="SendGrid" Version="9.29.3" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageVersion Include="SharpToken" Version="2.0.6" />
        <!-- ClosedXML takes SixLabors.Fonts 1.0.0 to 2.x. From 2.0 on it ships under the Six Labors Split License,
             which charges larger companies; 1.0.x is Apache-2.0. -->
        <PackageVersion Include="SixLabors.Fonts" Version="1.0.1" />
        <PackageVersion Include="SkiaSharp" Version="4.153.1" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
        <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.2" />
        <!-- No project references it: AWSSDK.CloudWatch brings 9.0.5 through AWSSDK.Extensions.CborProtocol, which
             carries the November 2026 .NET denial-of-service advisory (GHSA-vmv3-wvjp-wqpj). Transitive pinning
             lifts it. Drop the pin once AWSSDK.Extensions.CborProtocol depends on a patched build. -->
        <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
        <!-- One version with Microsoft.IdentityModel.Protocols.OpenIdConnect: see the comment there. -->
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
        <PackageVersion Include="System.IO.Packaging" Version="10.0.13" />
        <PackageVersion Include="System.Memory.Data" Version="10.0.3" />
        <PackageVersion Include="System.Runtime.Caching" Version="10.0.13" />
        <!-- No project references these two: Aspose, MimeKit, SqlClient and DataProtection bring older builds that
             carry the October 2026 .NET denial-of-service advisories. Transitive pinning lifts every path to these. -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
        <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>
</Project>
