<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body1">
                @FileName is password-protected. Enter its password to upload an unlocked copy.
            </MudText>

            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                The unlocked copy is stored and visible to everyone in your organization.
                The password is used once to unlock the file and is never stored.
            </MudText>

            @if (IsRetry)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    The password is incorrect. Try again, or skip this file.
                </MudAlert>
            }

            <MudTextField T="string"
                          @bind-Value="_password"
                          Label="Password"
                          InputType="InputType.Password"
                          Immediate="true"
                          OnKeyDown="OnKeyDown" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            Skip file
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@string.IsNullOrEmpty(_password)"
                   OnClick="Submit">
            Unlock
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string FileName { get; set; } = string.Empty;

    [Parameter] public bool IsRetry { get; set; }

    private string _password = string.Empty;

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void Submit()
    {
        if (!string.IsNullOrEmpty(_password))
        {
            MudDialog?.Close(DialogResult.Ok(_password));
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit();
        }
    }
}
