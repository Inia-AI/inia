@using IniaAi.Domain.Entities.UserManagement
@using IniaAi.Domain.UserData.Interfaces
@using IniaAi.WebApp.Services
@using Microsoft.AspNetCore.Identity

@inject UserAccountAdminService UserAccountAdminService
@inject IUserDataUnitOfWork UserDataUnitOfWork
@inject AppState AppState
@inject ILogger<ResetUserPasswordDialog> Logger

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudStack>
            <MudText Typo="Typo.body2">
                Set a new password for <b>@(User.GetFullName())</b> (@User.Email).
                The user's existing sessions are invalidated.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudTextField T="string"
                              Label="New Password"
                              @bind-Value="_newPassword"
                              InputType="InputType.Password"
                              Validation="@(new Func<string, IEnumerable<string>>(PasswordPolicy.Problems))"
                              Required="true"
                              RequiredError="@PasswordPolicy.REQUIRED" />

                <MudTextField T="string"
                              Label="Confirm Password"
                              @bind-Value="_confirmPassword"
                              InputType="InputType.Password"
                              Validation="@(new Func<string, string?>(ValidateConfirmation))"
                              Required="true"
                              RequiredError="Password confirmation is required!" />
            </MudForm>

            @foreach (var error in _errors)
            {
                <MudText Typo="Typo.body1" Color="Color.Error">@error</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_isBusy" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="_isBusy" Color="Color.Primary" Variant="Variant.Text" OnClick="ResetPasswordAsync">Reset Password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired]
    public User User { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isBusy;
    private string? _newPassword;
    private string? _confirmPassword;
    private List<string> _errors = new();

    #region Private

    private string? ValidateConfirmation(string confirmation)
    {
        return confirmation == _newPassword ? null : "The password and confirmation password do not match.";
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task ResetPasswordAsync()
    {
        await _form.ValidateAsync();

        if (!_isValid || _newPassword is null)
        {
            return;
        }

        _isBusy = true;
        _errors.Clear();

        try
        {
            IdentityResult result = await UserAccountAdminService.ResetPasswordAsync(User, _newPassword);

            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors.Select(e => e.Description));
                return;
            }

            AppState.Notify("Password reset successfully", Severity.Success);
            Logger.LogInformation("Password reset for user '{id}'", User.Id);

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await UserDataUnitOfWork.UntrackAsync(User);
            Logger.LogError(ex, "Password reset failed for user '{id}'", User.Id);
            _errors.Add($"Password reset failed: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
        }
    }

    #endregion
}
