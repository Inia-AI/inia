@using IniaAi.Domain.Business
@using IniaAi.Domain.Entities.UserManagement
@using IniaAi.Domain.UserData.Interfaces
@using Microsoft.AspNetCore.Identity

@inject IUserDataUnitOfWork UserDataUnitOfWork
@inject ILookupNormalizer Normalizer

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField Label="First Name"
                          ShrinkLabel="true"
                          @bind-Value="User.FirstName"
                          Required="true" />

            <MudTextField Label="Last Name"
                          ShrinkLabel="true"
                          @bind-Value="User.LastName"
                          Required="true" />

            <MudTextField Label="Middle Name (Optional)"
                          ShrinkLabel="true"
                          @bind-Value="User.MiddleName" />

            <MudTextField Label="Username"
                          ShrinkLabel="true"
                          @bind-Value="User.UserName"
                          Validation="@(new Func<string?, string?>(UserNameProblem))" />

            <MudTextField Label="Email"
                          ShrinkLabel="true"
                          @bind-Value="User.Email"
                          Required="true" />

            <MudDivider />

            <MudText Typo="Typo.h6">Current Organizations</MudText>
            @if (_userOrganizations.Any())
            {
                <MudStack Spacing="1">
                    @foreach (var userOrg in _userOrganizations)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                                @userOrg.Organization?.Name
                            </MudChip>
                            @if (userOrg.IsDefault)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" Title="Default Organization" />
                            }
                        </MudStack>
                    }
                </MudStack>

                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Use the organization management button in the user table for advanced organization assignment.
                </MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text">
                    This user is not assigned to any organizations. Use the organization management button in the user table to assign organizations.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Text"
                   OnClick="Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string USER_NAME_RULE = "A user name may hold only letters, digits and - . _ @ +";

    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public User User { get; set; } = default!;

    private List<UserOrganization> _userOrganizations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserOrganizations();
    }

    private async Task LoadUserOrganizations()
    {
        var userOrgs = await UserDataUnitOfWork.Repository<UserOrganization>()
            .FindAsync(uo => uo.UserId == User.Id && uo.IsActive);

        // Load organizations for each UserOrganization
        foreach (var userOrg in userOrgs)
        {
            userOrg.Organization = await UserDataUnitOfWork.Organizations.GetByIdAsync(userOrg.OrganizationId)
                ?? throw new InvalidOperationException($"Organization with ID {userOrg.OrganizationId} not found.");
        }

        _userOrganizations = userOrgs.OrderBy(uo => uo.Organization?.Name).ToList();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private static string? UserNameProblem(string? userName)
    {
        return IdentityUserNames.Accepts(userName) ? null : USER_NAME_RULE;
    }

    private void Save()
    {
        if (!IdentityUserNames.Accepts(User.UserName))
        {
            return;
        }

        User.NormalizedUserName = Normalizer.NormalizeName(User.UserName);
        User.NormalizedEmail = Normalizer.NormalizeEmail(User.Email);
        MudDialog?.Close(DialogResult.Ok(true));
    }
}
