@using IniaAi.WebApp.Services
@using Microsoft.AspNetCore.Http

@inject AppState AppState

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["IniaAi.WebApp.styles.css"]" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="32x32" />
    <link rel="icon" href="@Assets["icon.svg"]" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />

    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <div id="reconnect-modal" style="display: none;"></div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="boot.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/menu-accessibility.js"]"></script>
    <script src="@Assets["js/expansion-panel-accessibility.js"]"></script>
    <script src="@Assets["js/mathjax-config.js"]"></script>
    <script src="_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"></script>
    <script src="Components/Layout/MainLayout.razor.js"></script>
    <script src="PDFObject-2.3.0/pdfobject.js"></script>
    <script src="@Assets["js/document-preview.js"]"></script>
    <script src="@Assets["js/print-component.js"]"></script>
    <script src="qrcode.min.js"></script>
    <script src="@Assets["js/tag-highlight.js"]"></script>
    <script src="@Assets["js/clipboard.js"]"></script>
    <script src="@Assets["js/editor-agent.js"]"></script>
    <script src="@Assets["js/prompt-editor.bundle.js"]"></script>
    <script src="@Assets["js/editor-scroll.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // prerender: false — with the default (true) every hard reload executed the whole
    // component tree twice: once for the static prerender pass, once when the circuit
    // connected (double OnInitializedAsync, double DB loads, visible double render).
    // Nothing here consumes the prerendered HTML: authenticated internal tool, no SEO,
    // no PersistentComponentState.
    private static readonly IComponentRenderMode _interactiveServerWithoutPrerender =
        new InteractiveServerRenderMode(prerender: false);

    private IComponentRenderMode? RenderModeForPage => HttpContext.Request.Path.StartsWithSegments("/Account")
        ? null
        : _interactiveServerWithoutPrerender;
}
