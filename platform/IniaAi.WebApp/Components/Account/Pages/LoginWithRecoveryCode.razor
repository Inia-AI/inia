@page "/Account/LoginWithRecoveryCode"
@attribute [EnableRateLimiting(SignInRateLimitSettings.POLICY_NAME)]

@using System.ComponentModel.DataAnnotations
@using IniaAi.Application.Auditing
@using IniaAi.Domain.Entities.UserManagement
@using IniaAi.WebApp.Components.Account.Shared
@using Microsoft.AspNetCore.Identity
@using IniaAi.WebApp.Extensions
@using IniaAi.Configuration.Security
@using Microsoft.AspNetCore.RateLimiting

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IAuthenticationAuditLog Audit

<PageTitle>Recovery code verification</PageTitle>

<h1>Recovery code verification</h1>
<hr />
<StatusMessage Message="@message" />
<p>
    You have requested to log in with a recovery code. This login will not be remembered until you provide
    an authenticator app code at log in or disable 2FA and log in again.
</p>
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="RecoveryCode" />
                <label for="recovery-code" class="form-label">Recovery Code</label>
                <ValidationMessage For="() => Input.RecoveryCode" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private User user = default!;

    [SupplyParameterFromForm]
# pragma warning disable BL0008
    private InputModel Input { get; set; } = new();
# pragma warning restore BL0008

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Ensure the user has gone through the username & password screen first
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Unable to load two-factor authentication user.");
    }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnValidSubmitAsync()
    {
        var recoveryCode = Input.RecoveryCode.Replace(" ", string.Empty);

        var result = await SignInManager.TwoFactorRecoveryCodeSignInAsync(recoveryCode);

        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            await RecordAsync(AuthenticationAuditKind.SignInSucceeded, userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            await RecordAsync(AuthenticationAuditKind.SignInLockedOut, userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            await RecordAsync(AuthenticationAuditKind.SignInRefused, userId);
            message = "Error: Invalid recovery code entered.";
        }
    }

    private Task RecordAsync(AuthenticationAuditKind kind, string userId)
    {
        return Audit.RecordAsync(new AuthenticationAuditEvent(kind, userId, AuthenticationAuditMethods.RECOVERY, HttpContext.ClientAddress()));
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Text)]
        [Display(Name = "Recovery Code")]
        public string RecoveryCode { get; set; } = "";
    }
}
