    private void OnCategorySelected(string? key)
    {
        string selected = key ?? ALL_CATEGORIES_KEY;
        _filter.CategoryId = selected is ALL_CATEGORIES_KEY or UNCATEGORIZED_KEY ? null : selected;
        _filter.UncategorizedOnly = selected == UNCATEGORIZED_KEY;
