    private RefEntryDisplay? ResolveRefDisplay(Block block)
    {
        if (block.SharedComponentId is null)
        {
            return null;
        }

        SharedComponentSummaryDto? target = _components.FirstOrDefault(c => c.Id == block.SharedComponentId);
        return target is null ? null : new RefEntryDisplay(target.Name, target.HeadContentHash);
    }

    private async Task InsertRefFromLibraryAsync(int index)
    {
        if (_editComponentSection is null)
        {
            return;
        }

        SharedComponentSummaryDto? picked = await DialogService.PickLibraryComponentAsync(
            SharedComponentKind.Block, INSERT_REF_DIALOG_TITLE);
        if (picked is null)
        {
            return;
        }

        var inserted = new Block(
            DomainBlockTypes.AiQuery, _editComponentSection, index, UniqueRefTag(_editComponentSection));
        StampRef(inserted, picked);
        AuthoringSurfaceState.NotifySectionChanged(_editComponentSection);
    }

    private async Task SwapRefAsync(Block block)
    {
        SharedComponentSummaryDto? picked = await DialogService.PickLibraryComponentAsync(
            SharedComponentKind.Block, SWAP_REF_DIALOG_TITLE);
        if (picked is null)
        {
            return;
        }

        StampRef(block, picked);
        if (_editComponentSection is not null)
        {
            AuthoringSurfaceState.NotifySectionChanged(_editComponentSection);
        }
    }

    private static void StampRef(Block block, SharedComponentSummaryDto target)
    {
        block.SharedComponentId = target.Id;
        block.SharedComponentLinkState = DomainLinkState.Linked;
        block.SharedComponentVersionHash = target.HeadContentHash;
        block.SharedComponentBindings = null;
    }

    private static string UniqueRefTag(Section section)
    {
        return section.MintFreeReplacementTag(REF_TAG_PREFIX, 1);
    }

    private Task<TResponse> SendAsync<TResponse>(IRequest<TResponse> request)
    {
        return ServiceScopeFactory.SendScopedAsync(request);
    }
