    private async Task RecategorizeAsync(SharedComponentCategoryDto category)
    {
        if (_selectedComponent is null || string.IsNullOrEmpty(_organizationId) || string.IsNullOrEmpty(_userId))
        {
            return;
        }

        ErrorOr<SharedComponentSummaryDto> result = await SendAsync(
            new SetSharedComponentCategoryCommand(_organizationId, _userId, _selectedComponent.Id, category.Id));

        if (result.IsError)
        {
            AppState.Notify(
                $"Could not move the component: {result.FirstError.Description}",
                Severity.Error);
            return;
        }

        _selectedComponent = result.Value;
        int index = _components.FindIndex(c => c.Id == result.Value.Id);
        if (index >= 0)
        {
            _components[index] = result.Value;
        }

        await LoadCategoriesAsync();
        AppState.Notify($"Moved to '{category.Name}'.", Severity.Success);
    }

    private async Task OpenManageCategoriesAsync()
    {
        if (string.IsNullOrEmpty(_organizationId) || string.IsNullOrEmpty(_userId))
        {
            return;
        }

        var parameters = new DialogParameters<ManageSharedComponentCategoriesDialog>
        {
            { dialog => dialog.OrganizationId, _organizationId },
            { dialog => dialog.UserId, _userId },
        };
        IDialogReference dialog = await DialogService.ShowAsync<ManageSharedComponentCategoriesDialog>(
            "Manage categories",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LoadCategoriesAsync();
            await LoadComponentsAsync();
        }
    }

    private void SetKind(SharedComponentKind? kind)
    {
        _filter.Kind = kind;
    }

    private string? ConsumingCategoryKey
    {
        get => _filter.ConsumingWorkflowTypeCategoryId;
        set
        {
            _filter.ConsumingWorkflowTypeCategoryId = value;
            if (_filter.ConsumingWorkflowTypeId is not null
                && !ConsumingTypeOptions().Any(t =>
                    string.Equals(t.WorkflowTypeId, _filter.ConsumingWorkflowTypeId, StringComparison.Ordinal)))
            {
                _filter.ConsumingWorkflowTypeId = null;
            }
        }
    }

    private IReadOnlyList<ConsumingWorkflowTypeDto> ConsumingTypeOptions()
    {
        IEnumerable<ConsumingWorkflowTypeDto> consumingTypes = _allConsumingTypes;
        if (_filter.ConsumingWorkflowTypeCategoryId is not null)
        {
            consumingTypes = consumingTypes.Where(t =>
                string.Equals(t.CategoryId, _filter.ConsumingWorkflowTypeCategoryId, StringComparison.Ordinal));
        }

        return [.. consumingTypes
            .GroupBy(t => t.WorkflowTypeId, StringComparer.Ordinal)
            .Select(g => g.First())
            .OrderBy(t => t.WorkflowTypeName, StringComparer.Ordinal)];
    }

    private IReadOnlyList<(string Id, string Name)> ConsumingTypeCategoryOptions()
    {
        return [.. _allConsumingTypes
            .Where(t => t.CategoryId is not null)
            .GroupBy(t => t.CategoryId!, StringComparer.Ordinal)
            .Select(g => (Id: g.Key, Name: g.First().CategoryName ?? g.Key))
            .OrderBy(o => o.Name, StringComparer.Ordinal)];
    }

    private string ConsumingTypeLabel(string workflowTypeId)
    {
        return _allConsumingTypes
            .FirstOrDefault(t => string.Equals(t.WorkflowTypeId, workflowTypeId, StringComparison.Ordinal))
            ?.WorkflowTypeName ?? workflowTypeId;
    }

    private string ConsumingTypeCategoryLabel(string categoryId)
    {
        return _allConsumingTypes
            .FirstOrDefault(t => string.Equals(t.CategoryId, categoryId, StringComparison.Ordinal))
            ?.CategoryName ?? categoryId;
    }

    private IEnumerable<string> ConsumerDomains()
    {
        return (_consumers ?? [])
            .Select(c => c.CategoryName)
            .Where(d => !string.IsNullOrEmpty(d))
            .Select(d => d!)
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal);
    }

    private static string ConsumerLabel(SharedComponentConsumer consumer)
    {
        return string.IsNullOrWhiteSpace(consumer.WorkflowTypeName)
            ? consumer.WorkflowTypeId
            : consumer.WorkflowTypeName;
    }

