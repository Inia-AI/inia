    /// <summary>The feedback the agent suggests dismissing, each with its Dismiss button while it is open.</summary>
    private RenderFragment Dismissals(EditorAgentTurnView turn) => __builder =>
    {
        <div class="editor-agent-dismissals" data-testid="editor-agent-dismissals">
            <div class="editor-agent-caption">The agent suggests dismissing this feedback. Dismissing hides it as not a workflow problem.</div>
            @foreach (EditorAgentDismissSuggestionView suggestion in turn.DismissSuggestions)
            {
                <div class="editor-agent-dismissal"
                     @key="suggestion.FeedbackItemId"
                     data-testid="editor-agent-dismissal"
                     data-feedback-id="@suggestion.FeedbackItemId">
                    <div class="editor-agent-dismissal-text">
                        <div>&ldquo;@suggestion.Comment&rdquo;</div>
                        <div class="editor-agent-caption">@suggestion.Reason</div>
                    </div>
                    @if (suggestion.Status == ReportFeedbackStatus.Open)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Disabled="@_isDismissing"
                                   OnClick="@(() => DismissAsync(turn, suggestion))"
                                   data-testid="editor-agent-dismiss">
                            @DISMISS
                        </MudButton>
                    }
                    else
                    {
                        <span class="editor-agent-caption" data-testid="editor-agent-dismissal-status">@EditorAgentText.FeedbackStatus(suggestion.Status)</span>
                    }
                </div>
            }
        </div>
    };

    private async Task DismissAsync(EditorAgentTurnView turn, EditorAgentDismissSuggestionView suggestion)
    {
        _isDismissing = true;
        try
        {
            ErrorOr<Success> dismissed = await AgentService.DismissFeedbackAsync(OrganizationId, UserId, turn.Id, suggestion.FeedbackItemId);
            if (dismissed.IsError)
            {
                Snackbar.Add(dismissed.FirstError.Description, Severity.Warning);
            }
        }
        finally
        {
            _isDismissing = false;
        }

        await ReloadConversationAsync();
    }

    private async Task CountOpenFeedbackAsync()
    {
        if (!_canUse || _isDisposed)
        {
            return;
        }

        ErrorOr<int> open = await AgentService.CountOpenFeedbackAsync(OrganizationId, UserId, WorkflowTypeId);
        _openFeedback = open.IsError ? 0 : open.Value;
    }

    private async Task ChooseReportsAsync()
    {
        var parameters = new DialogParameters<EditorAgentReportsDialog>
        {
            { dialog => dialog.OrganizationId, OrganizationId },
            { dialog => dialog.UserId, UserId },
            { dialog => dialog.WorkflowTypeId, WorkflowTypeId },
            { dialog => dialog.Chosen, [.. _pickedReports] },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<EditorAgentReportsDialog>(null, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: IReadOnlyList<EditorAgentReportSummary> chosen })
        {
            _pickedReports.Clear();
            _pickedReports.AddRange(chosen.Take(EditorAgentReports.MAX_PICKED));
            StateHasChanged();
        }
    }

    private void Unpick(EditorAgentReportSummary report)
    {
        _ = _pickedReports.RemoveAll(picked => picked.Id == report.Id);
    }

    private async Task StopAsync(EditorAgentTurnView turn)
    {
        _isStopping = true;
        try
        {
            ErrorOr<Success> stopped = await AgentService.CancelTurnAsync(OrganizationId, UserId, turn.Id);
            if (stopped.IsError)
            {
                Snackbar.Add(stopped.FirstError.Description, Severity.Warning);
            }
        }
        finally
        {
            _isStopping = false;
        }
    }

    private async Task StartNewConversationAsync()
    {
        // A new conversation starts on the default model; the old conversation's model is not carried over.
        ErrorOr<EditorAgentConversationView> started = await AgentService.StartNewConversationAsync(
            OrganizationId, UserId, WorkflowTypeId, modelId: null);
        if (started.IsError)
        {
            Snackbar.Add(started.FirstError.Description, Severity.Warning);
            return;
        }

        IReadOnlyList<EditorAgentModelOption> models = await AgentService.ListModelsAsync(OrganizationId, started.Value.ModelId);
        _models.Clear();
        _models.AddRange(models);
        _live = null;
        CloseDrawer();
        ShowConversation(started.Value, ++_readTicket);
        _selectedModelId = SelectedOrDefault(started.Value.ModelId);
    }

    private void OnTurnUpdated(object? sender, EditorAgentTurnUpdate update)
    {
        if (update.OrganizationId != OrganizationId || _conversation is null || update.ConversationId != _conversation.Id)
        {
            return;
        }

        _ = InvokeAsync(() => ApplyUpdateAsync(update));
    }

    private async Task ApplyUpdateAsync(EditorAgentTurnUpdate update)
    {
        if (_conversation is null || update.ConversationId != _conversation.Id)
        {
            return;
        }

        bool settled = update.Status is AgentConversationTurnStatus status && !status.IsInFlight();
        if (settled)
        {
            await SettleAsync();
            return;
        }

        if (update.Activity is not null)
        {
            _live = new LiveActivity(update.TurnNumber, update.Activity);
        }

        if (update.Status is not null && _conversation.Turns.All(turn => turn.Number != update.TurnNumber))
        {
            await ReloadConversationAsync();
        }
        else if (update.Status is AgentConversationTurnStatus running
            && _conversation.Turns.Any(turn => turn.Number == update.TurnNumber && turn.Status.IsInFlight()))
        {
            // A late notice never takes a settled turn back to running, and it does not void a
            // read already on its way.
            ShowConversation(_conversation with
            {
                Turns = [.. _conversation.Turns.Select(turn => turn.Number == update.TurnNumber ? turn with { Status = running } : turn)],
            }, _appliedTicket);
        }

        StateHasChanged();
    }

    private async Task SettleAsync()
    {
        _live = null;
        await ReloadConversationAsync();
        StateHasChanged();
    }

    private async Task ReloadConversationAsync()
    {
        if (_conversation is null)
        {
            return;
        }

        long ticket = ++_readTicket;
        ErrorOr<EditorAgentConversationView> reloaded = await AgentService.GetConversationAsync(
            OrganizationId, UserId, _conversation.Id);
        if (!reloaded.IsError)
        {
            ShowConversation(reloaded.Value, ticket);
        }

        // A save, a dismissal or another user's feedback changes what is open.
        await CountOpenFeedbackAsync();
    }

    /// <summary>
    /// Shows the conversation and, while a turn runs, checks it every few seconds in case a
    /// settle notification was missed (a reload during the turn, or a turn another host settled).
    /// A read that started before the one already shown is dropped, so a slow poll cannot bring
    /// a settled turn back to running.
    /// </summary>
    private void ShowConversation(EditorAgentConversationView conversation, long ticket)
    {
        if (_isDisposed || ticket < _appliedTicket)
        {
            return;
        }

        _appliedTicket = ticket;
        _conversation = conversation;
        SyncReviews(conversation);

        if (InFlightTurn is null)
        {
            _safetyPoll?.Dispose();
            _safetyPoll = null;
            return;
        }

        _safetyPoll ??= new Timer(
            _ => _ = InvokeAsync(PollAsync),
            state: null,
            TimeSpan.FromSeconds(SAFETY_POLL_SECONDS),
            TimeSpan.FromSeconds(SAFETY_POLL_SECONDS));
    }

    /// <summary>One review per proposal, kept across re-reads so its conflicts and notes survive.</summary>
    private void SyncReviews(EditorAgentConversationView conversation)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (EditorAgentTurnView turn in conversation.Turns)
        {
            if (turn.Proposal is not { } proposal)
            {
                continue;
            }

            _ = seen.Add(turn.Id);
            if (_reviews.TryGetValue(turn.Id, out EditorAgentProposalReview? review))
            {
                review.Proposal = proposal;
            }
            else
            {
                _reviews[turn.Id] = new EditorAgentProposalReview(AgentService, OrganizationId, UserId, turn.Id, proposal);
            }
        }

        foreach (string gone in _reviews.Keys.Where(turnId => !seen.Contains(turnId)).ToList())
        {
            _ = _reviews.Remove(gone);
        }

        HashSet<string> proposed = [.. _reviews.Values
            .SelectMany(static review => review.Undecided)
            .Select(static view => view.Change)
            .Select(static change => change.Scope switch
            {
                ProposedChangeScope.Block when change.Kind == ProposedChangeKind.Added => change.SectionKey,
                ProposedChangeScope.Block or ProposedChangeScope.Section => change.TargetKey,
                _ => null,
            })
            .OfType<string>()];
        if (!proposed.SetEquals(_proposed))
        {
            _proposed = proposed;
            _ = OnProposedChanged.InvokeAsync(proposed);
            _ = OnPreviewChanged.InvokeAsync(proposed.Count == 0 ? null : BuildPreview());
        }
    }

    /// <summary>
    /// A copy of the editor's workflow with every undecided change applied, the agent's value taken
    /// where the user changed the same field, and which blocks those changes add or change.
    /// </summary>
    private EditorAgentPreview? BuildPreview()
    {
        if (Workflow.FromJson(CurrentWorkflow().ToExportJson()) is not { } copy)
        {
            return null;
        }

        var marks = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (EditorAgentProposalReview review in _reviews.Values)
        {
            List<ProposedChange> changes = [.. review.Proposal.Changes
                .Where(static view => EditorAgentProposalReview.IsUndecided(view) && view.Change.CanAccept)
                .Select(static view => view.Change)];
            if (changes.Count == 0)
            {
                continue;
            }

            Dictionary<string, ProposedChange> byId = changes.ToDictionary(static change => change.Id, StringComparer.Ordinal);
            ProposalApplyResult result = WorkflowProposalApplier.Apply(
                copy, changes, new HashSet<string>(byId.Keys, StringComparer.Ordinal));
            foreach (ProposalAppliedChange applied in result.Applied)
            {
                ProposedChange change = byId[applied.ChangeId];
                foreach (Block block in PreviewBlocks(copy, change, applied.MintedStableId))
                {
                    string mark = change.Kind == ProposedChangeKind.Added ? EditorAgentPreview.ADDED : EditorAgentPreview.CHANGED;
                    if (!marks.ContainsKey(block.Id) || mark == EditorAgentPreview.ADDED)
                    {
                        marks[block.Id] = mark;
                    }
                }
            }
        }

        return new EditorAgentPreview(copy, marks);
    }

    /// <summary>The blocks of the copy one applied change adds or changes; renumbering touches none.</summary>
    private static IEnumerable<Block> PreviewBlocks(Workflow copy, ProposedChange change, string? minted)
    {
        if (change.Incidental || change.Kind == ProposedChangeKind.Removed)
        {
            return [];
        }

        string? key = minted ?? change.TargetKey;
        return change.Scope switch
        {
            ProposedChangeScope.Block => copy.GetAllBlocks().Where(block => block.StableBlockId == key),
            ProposedChangeScope.Section when change.Kind == ProposedChangeKind.Added =>
                copy.Sections.Where(section => section.StableSectionId == key).SelectMany(static section => section.Blocks),
            _ => [],
        };
    }

    /// <summary>
    /// Reads only the turn in flight: while it is the turn shown, its status and steps are patched
    /// in; once it settled or another turn took its place, the conversation is read again.
    /// </summary>
    private async Task PollAsync()
    {
        if (_isDisposed || _conversation is null || InFlightTurn is not { } shown)
        {
            return;
        }

        long ticket = ++_readTicket;
        ErrorOr<EditorAgentInFlightTurn?> polled = await AgentService.GetInFlightTurnAsync(
            OrganizationId, UserId, _conversation.Id);
        if (_isDisposed || polled.IsError || ticket < _appliedTicket || _conversation is null)
        {
            return;
        }

        EditorAgentInFlightTurn? inFlight = polled.Value;
        if (inFlight is null || inFlight.Number != shown.Number)
        {
            _live = null;
            await ReloadConversationAsync();
        }
        else if (inFlight.Status != shown.Status || inFlight.IsWaiting != shown.IsWaiting)
        {
            ShowConversation(_conversation with
            {
                Turns = [.. _conversation.Turns.Select(turn => turn.Number == inFlight.Number
                    ? turn with { Status = inFlight.Status, IsWaiting = inFlight.IsWaiting }
                    : turn)],
            }, ticket);
        }

        if (inFlight?.Activity is { } activity && InFlightTurn?.Number == inFlight.Number)
        {
            _live = new LiveActivity(inFlight.Number, activity);
        }

        StateHasChanged();
    }

    private AgentActivityDigest? LiveDigestOf(EditorAgentTurnView turn)
    {
        return _live is { } live && live.TurnNumber == turn.Number ? live.Digest : null;
    }

    private string WorkingLabel(EditorAgentTurnView turn)
    {
        if (turn.Status == AgentConversationTurnStatus.Queued)
        {
            return "Getting ready...";
        }

        AgentActivityDigest? live = LiveDigestOf(turn);
        if (live?.Beats.LastOrDefault() is { } beat && beat.PhaseIndex >= 0 && beat.PhaseIndex < live.Phases.Count)
        {
            return live.Phases[beat.PhaseIndex].GapLabel;
        }

        return "Reading the workflow...";
    }
}
