@using IniaAi.Domain.Core.Interfaces
@using IniaAi.Domain.Entities.Workflows
@using IniaAi.Domain.UserData.Interfaces

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudSelect T="Section"
                   Label="Select Section To Move The Block To"
                   Variant="Variant.Outlined"
                   @bind-Value="SelectedSection">
            @if (!_sectionsToMoveTo.Any())
            {
                <MudSelectItem T="Section" Disabled>
                    No Sections To Choose From
                </MudSelectItem>
            }
            else
            {
                foreach (var section in _sectionsToMoveTo)
                {
                    <MudSelectItem T="Section" Value="@section">
                        @section.Order. @section.Title
                    </MudSelectItem>
                }
            }
        </MudSelect>

        <MudTextField Label="New Position Of The Block"
                      Variant="Variant.Outlined"
                      Margin="0"
                      @bind-Value="@NewPosition" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="Confirm">
            Confirm
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Section> _sectionsToMoveTo => TopLevelWorkflow.Sections.Where(s => !s.IsSeparator).ToList();

    [Parameter]
    public Section? SelectedSection { get; set; }

    [Parameter]
    public int NewIndex { get; set; }

    private int NewPosition
    {
        get => NewIndex;
        set => NewIndex = Math.Max(0, value);
    }

    [Parameter]
    public Workflow TopLevelWorkflow { get; set; } = default!;

    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void Confirm()
    {
        MudDialog?.Close(DialogResult.Ok((SelectedSection, NewIndex)));
    }
}
