@inject IJSRuntime JsRuntime

<MudDialog>
    <DialogContent>
        @if (Text is null)
        {
            <MudText Typo="Typo.body2">The text of this page is not in this run.</MudText>
        }
        else
        {
            <div class="citation-trace-page">@Before<mark id="@MARK_ID">@Highlighted</mark>@After</div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .citation-trace-page {
        max-height: 60vh;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: .875rem;
    }

    .citation-trace-page mark {
        background: var(--mud-palette-warning);
        color: var(--mud-palette-warning-text);
    }
</style>

@code {
    private const string MARK_ID = "citation-trace-page-span";

    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The page text, or null when the run carries no text for the page.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>The cited span, set only when it fits in <see cref="Text"/>.</summary>
    [Parameter]
    public Range? Span { get; set; }

    private string Before => Span is Range span ? Text![..span.Start] : Text ?? string.Empty;

    private string Highlighted => Span is Range span ? Text![span] : string.Empty;

    private string After => Span is Range span ? Text![span.End..] : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Span is not null)
        {
            await JsRuntime.InvokeVoidAsync("scrollToElement", MARK_ID);
        }
    }
}
