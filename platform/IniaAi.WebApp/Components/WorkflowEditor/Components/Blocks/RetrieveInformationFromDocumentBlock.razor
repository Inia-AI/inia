@using Block = Domain.Entities.Workflows.Blocks.Block
@using IniaAi.Domain.Entities.Workflows
@using IniaAi.Domain.Entities.Workflows.Blocks.Properties
@using IniaAi.Domain.Entities.Workflows.Enums

<div class="editor-eyebrow mt-2 mb-2">Documents &amp; filtering</div>

<MudCheckBox T="bool"
             Label="Get Overviews"
             Color="Color.Primary"
             @bind-Value="@_props.ShouldUseOverviews" />

<DocumentClassSelector Block="@Block"
                       SelectionChanged="@BlockChanged" />

@foreach (RagSettings ragSettings in Block.RagSettings)
{
    <MudPaper @key="ragSettings" Elevation="0" Outlined="true" Class="pa-3 mb-2 rounded">
        <RagSettingsInteraction RagSettings="@ragSettings" />

        <MudButton Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Delete"
                   Color="Color.Error"
                   Class="editor-soft-button"
                   OnClick="() => Block.RagSettings.Remove(ragSettings)">
            Remove Data Retrieval Settings
        </MudButton>
    </MudPaper>
}

<div>
    <MudButton Size="Size.Small"
               Class="editor-soft-button"
               Variant="Variant.Text"
               StartIcon="@Icons.Material.Outlined.Add"
               Color="Color.Primary"
               OnClick="() => { _ = new RagSettings(Block) { Type = RagTypes.WholeDocument }; }">
        Add Data Retrieval Settings
    </MudButton>
</div>

@code {
    private RetrieveDataFromDocumentsProperties _props => Block.Properties as RetrieveDataFromDocumentsProperties
        ?? throw new InvalidOperationException("Block properties must be of type RetrieveDataFromDocumentsProperties");

    [Parameter, EditorRequired]
    public EventCallback BlockChanged { get; set; }

    [Parameter, EditorRequired]
    public Block Block { get; set; } = default!;
}
