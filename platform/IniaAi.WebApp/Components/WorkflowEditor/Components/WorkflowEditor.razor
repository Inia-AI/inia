    private async Task UploadWorkflowFileAsync(
        IReadOnlyList<IBrowserFile> files,
        bool fromBundleMouth = false)
    {
        // The upload control reports a cleared selection as a null list.
        if (files is null)
        {
            return;
        }

        const int BufferSize = 4096;

        byte[] buffer = ArrayPool<byte>.Shared.Rent(BufferSize);

        try
        {
            await UploadFileAsync(files.First(), buffer, fromBundleMouth);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Failed to process file");

            AppState.Notify(
                "Failed to process workflow file",
                Severity.Error);
        }
        finally
        {
            ArrayPool<byte>.Shared.Return(buffer);
        }
    }

    private async Task UploadFileAsync(IBrowserFile file, byte[] buffer, bool fromBundleMouth = false)
    {
        using MemoryStream memoryStream = new();
        using var fileStream = file.OpenReadStream(maxAllowedSize: TransferBundleFile.MAX_FILE_SIZE_BYTES);

        while (await fileStream.ReadAsync(buffer) is int read && read > 0)
        {
            memoryStream.Write(buffer, 0, read);
        }

        string json = Encoding.UTF8.GetString(memoryStream.ToArray());

        if (TransferBundleFile.Classify(json) == TransferPayloadKind.TransferBundle)
        {
            WorkflowTransferBundle? bundle = TransferBundleFile.TryDeserialize(json);
            if (bundle is null)
            {
                AppState.Notify(
                    "That file looks like a workflow bundle but could not be read — it may be damaged.",
                    Severity.Error);

                return;
            }

            ClearFailedBlocksBanner();
            await OpenImportDialogAsync(bundle);

            return;
        }

        await ProcessWorkflowJsonUploadAsync(json, file.Name, fromBundleMouth);
    }

    private async Task ProcessWorkflowJsonUploadAsync(string json, string fileName, bool fromBundleMouth)
    {
        if (Workflow.DeclaresUnsupportedFormatVersion(json, out int declaredFormatVersion))
        {
            Logger.LogWarning(
                "Rejected workflow upload declaring format version {DeclaredFormatVersion}; this build supports up to {CurrentFormatVersion}",
                declaredFormatVersion,
                Workflow.CURRENT_FORMAT_VERSION);

            AppState.Notify(
                Workflow.UnsupportedFormatVersionMessage(declaredFormatVersion),
                Severity.Error);

            return;
        }

        Workflow? originalWorkflow = Workflow.FromExportJson(json);

        if (originalWorkflow is null)
        {
            Logger.LogError("Failed to parse workflow from JSON");

            AppState.Notify(
                "Could not read that workflow file — it may be damaged or saved in an older format.",
                Severity.Error);

            return;
        }

        if (Workflow.DeclaresUnsupportedFormatVersion(originalWorkflow.FormatVersion))
        {
            Logger.LogWarning(
                "Rejected workflow upload declaring format version {DeclaredFormatVersion}; this build supports up to {CurrentFormatVersion}",
                originalWorkflow.FormatVersion,
                Workflow.CURRENT_FORMAT_VERSION);

            AppState.Notify(
                Workflow.UnsupportedFormatVersionMessage(originalWorkflow.FormatVersion!.Value),
                Severity.Error);

            return;
        }

        // Both upload controls accept both kinds so nothing is ever silently dropped, and a workflow
        // file replaces everything on screen, so either control asks first.
        var replaceOptions = new MessageBoxOptions
        {
            Title = WorkflowFileImportPreview.TitleFor(fromBundleMouth),
            Message = WorkflowFileImportPreview.Describe(EditorContext.Workflow, originalWorkflow, fileName),
            YesText = "Replace the editor content",
            CancelText = "Cancel",
        };
        bool? replace = await DialogService.ShowMessageBoxAsync(replaceOptions, _smallDialogOptions);
        if (replace is not true)
        {
            AppState.Notify("Upload cancelled — this workflow is unchanged.", Severity.Info);

            return;
        }

        ClearFailedBlocksBanner();

        // Only preserve IDs when this is a true re-upload of the CURRENT tenant's
        // workflow under this workflow type — i.e. the uploaded root Id matches
        // the DB row `GetByTypeIdAsync` would return. In that case, block Ids line
        // up with SignatureFieldOverride rows so overrides keep applying after
        // Save-As-Core. Any other upload (fresh tenant, different workflow type
        // in the same DB, workflow whose Ids happen to collide with another row)
        // regenerates Ids via plain CloneTo so we never PK-collide on save.
        bool preserveIds = await IsReuploadOfCurrentWorkflowAsync(originalWorkflow);
        Workflow cloneWorkflow = new();
        if (preserveIds)
        {
            originalWorkflow.CloneToPreservingIds(cloneWorkflow);
        }
        else
        {
            originalWorkflow.CloneTo(cloneWorkflow);
        }

        originalWorkflow.CarryRunTracesTo(cloneWorkflow);
        cloneWorkflow.FormatVersion = null;

        _isUploadedFromFile = true;
        _restoredVersion = null;
        await ApplyLoadedWorkflowAsync(cloneWorkflow);
        AnalyzeFailedBlocks();

        await NotifyActiveOverrideCoverageAsync(cloneWorkflow);

        AppState.Notify(
            "Workflow uploaded successfully",
            Severity.Success);
    }

    /// <summary>
    /// Decides whether the uploaded JSON is a re-upload of the CURRENT tenant's existing
    /// workflow for this workflow-type (in which case preserving Ids is safe), or a
    /// foreign upload whose Ids might collide with other rows in Core.Workflows (in which
    /// case we must regenerate). SignatureFieldOverride rows are unaffected either way —
    /// they key on stable block ids, which survive both clone paths.
    /// Matches by root workflow Id; a match is the only signal strong enough to trust.
    /// </summary>
    private async Task<bool> IsReuploadOfCurrentWorkflowAsync(Workflow uploaded)
    {
        string? workflowTypeId = EditorContext.WorkflowTypeId;
        if (string.IsNullOrWhiteSpace(workflowTypeId) || string.IsNullOrWhiteSpace(uploaded.Id))
        {
            return false;
        }

        try
        {
            using IServiceScope scope = ServiceScopeFactory.CreateScope();
            ICoreUnitOfWork coreUnitOfWork = scope.ServiceProvider.GetRequiredService<ICoreUnitOfWork>();

            Workflow? currentCore = await coreUnitOfWork.Workflows.GetByTypeIdAsync(workflowTypeId);
            return currentCore is not null && currentCore.Id == uploaded.Id;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Id-preservation preflight failed; falling back to fresh-Id upload for safety.");
            return false;
        }
    }

    /// <summary>
    /// Surfaces a post-upload toast telling staff whether the current tenant has any
    /// active SignatureFieldOverride rows matching the uploaded workflow's signature
    /// field definitions. Overrides are never carried in the <c>.workflow</c> JSON —
    /// they live in a dedicated table keyed by <c>(org, workflow type, field name)</c>.
    /// So the count here reflects what the CURRENT tenant already has in its DB, not
    /// what the source tenant had. Zero-count on a cross-tenant upload is the expected
    /// "no leak" signal; zero-count on a same-tenant re-upload means the client hasn't
    /// authored any overrides yet (or the uploaded definitions' names no longer match
    /// the rows — e.g. fields were renamed since).
    /// </summary>
    private async Task NotifyActiveOverrideCoverageAsync(Workflow uploaded)
    {
        // Scope to the currently-selected tenant, not the user's default org —
        // a SuperAdmin browsing another tenant's editor must see that tenant's
        // override rows, not their own primary org's.
        string? organizationId = AppState.CurrentOrganizationId;
        if (string.IsNullOrEmpty(organizationId))
        {
            return;
        }

        HashSet<string> fieldNames = [.. uploaded.SignatureFields.Select(f => f.Name)];

        if (fieldNames.Count == 0)
        {
            return;
        }

        try
        {
            using IServiceScope scope = ServiceScopeFactory.CreateScope();
            ICoreDbContext coreDbContext = scope.ServiceProvider.GetRequiredService<ICoreDbContext>();

            int overrideCount = await coreDbContext.SignatureFieldOverrides
                .AsNoTracking()
                .Where(o => o.OrganizationId == organizationId
                    && o.WorkflowTypeId == uploaded.WorkflowTypeId
                    && fieldNames.Contains(o.PlaceholderName))
                .CountAsync();

            if (overrideCount == 0)
            {
                AppState.Notify(
                    "Upload complete — no active signature overrides exist for this workflow in this tenant. Fields will resolve to staff defaults.",
                    Severity.Info);
            }
            else
            {
                AppState.Notify(
                    $"Upload complete — {overrideCount} active signature override(s) will apply in this tenant.",
                    Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to compute active-override coverage after upload");
        }
    }

    private void UpdateDocumentClassesList()
    {
        var documentClasses = EditorContext.Workflow.GetDocumentClasses()
            .Except(["Any", "None"]);

        bool hasChanges = !_documentClasses.SequenceEqual(documentClasses);

        if (hasChanges)
        {
            _documentClasses.Clear();
            _documentClasses.Add(string.Empty);
            _documentClasses.AddRange(documentClasses);
            DocumentClassesChangedCallBack.InvokeAsync(_documentClasses);

            // This callback is wired through a non-rendering receiver (hot path:
            // every block edit lands here), so render explicitly on real changes.
            StateHasChanged();
        }
    }

    private List<(Block block, List<string> invalidTags)> FindBlocksWithInvalidReplacementTags()
    {
        var invalidBlocks = new List<(Block block, List<string> invalidTags)>();

        var allBlocks = EditorContext.Workflow.GetAllBlocks();

        foreach (var block in allBlocks)
        {
            var invalid = IniaAi.WebApp.Services.ReplacementTagUiValidationService.ValidateAllTextFieldsForBlock(block, EditorContext.Workflow);
            if (invalid.Any())
            {
                invalidBlocks.Add((block, invalid.Distinct().ToList()));
            }
        }

        return invalidBlocks;
    }

    private async Task ShowConsolidatedValidationWarningDialog(List<(Block block, List<string> invalidTags)> invalidBlocks)
    {
        var blockIssues = invalidBlocks.Select(item => new
        {
            BlockLocation = GetBlockLocationString(item.block),
            InvalidTags = item.invalidTags
        }).ToList();

        var parameters = new DialogParameters
        {
            ["BlockIssues"] = blockIssues,
            ["Workflow"] = EditorContext.Workflow
        };

        var options = new DialogOptions()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large
        };

        await DialogService.ShowAsync<ReplacementTagValidationDialog>(
            "Saved — with a replacement-tag warning",
            parameters,
            options);
    }

    private async Task ShowExpandedParameterizedBlockDialog(IReadOnlyList<string> expandedSectionTitles)
    {
        string sectionItems = string.Join("", expandedSectionTitles
            .Select(t => $"<li><strong>{System.Net.WebUtility.HtmlEncode(t)}</strong></li>"));

        var markupMessage = new MarkupString(
            "<p class=\"mb-2\">The following section(s) have already been expanded into their variants:</p>"
            + $"<ul class=\"mt-0 mb-3\">{sectionItems}</ul>"
            + "<p class=\"mb-2\"><strong>Saving as core would permanently discard the parameterized configuration.</strong></p>"
            + "<p class=\"mb-0 mud-text-secondary\">Load the un-expanded version before saving to core: re-upload the "
            + "original workflow file, or reload the core template. Expansion happens during execution and is not "
            + "meant to be saved back.</p>");

        var messageBoxOptions = new MessageBoxOptions
        {
            Title = "Cannot save expanded parameterized sections",
            MarkupMessage = markupMessage,
            YesText = "Got it"
        };

        await DialogService.ShowMessageBoxAsync(messageBoxOptions, _smallDialogOptions);
    }

    private string GetBlockLocationString(Block block)
    {
        if (block.Section is null)
        {
            return "Unknown Block";
        }

        var sectionNumber = block.Section.Order;
        var blockNumber = block.Order;

        var sectionName = !string.IsNullOrWhiteSpace(block.Section.Title)
            ? $"Section {sectionNumber}: {block.Section.Title}"
            : $"Section {sectionNumber}";

        var blockName = !string.IsNullOrWhiteSpace(block.Name)
            ? $"Block {blockNumber}: {block.Name}"
            : $"Block {blockNumber}";

        return $"{sectionName} → {blockName}";
    }

    private bool HasExecutionData()
    {
        return EditorContext.Workflow.Sections
            .Any(section => section.ExecutionState is not null);
    }

    private async Task<bool> ShowSaveExecutedWorkflowConfirmationAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<SaveExecutedWorkflowConfirmationDialog>(
            "Confirm Save",
            _smallDialogOptions);
        DialogResult? result = await dialog.Result;

        return result is not null && !result.Canceled;
    }

    private void AnalyzeFailedBlocks()
    {
        _failedBlocks.Clear();
        _retriedBlocks.Clear();

        var allBlocks = EditorContext.Workflow.GetAllBlocks();

        foreach (var block in allBlocks)
        {
            if (block.ExecutionState?.HasFailed == true)
            {
                var location = GetBlockLocationString(block);
                var errorMessage = block.ExecutionState?.Error ?? "Unknown error";
                _failedBlocks.Add((block, location, errorMessage));
                continue;
            }

            // Retried-and-passed: AI Query block whose validator rejected the first
            // response and accepted the retry. Gate on Completed so stale
            // OutputFormatAttemptCount on a never-run block doesn't surface here.
            if (block.ExecutionState?.Status == ExecutionStatus.Completed
                && block.Properties is AiQueryProperties aiProps
                && aiProps.OutputFormatAttemptCount > 1
                && aiProps.OutputFormatLastError is not null)
            {
                var location = GetBlockLocationString(block);
                _retriedBlocks.Add((block, location, aiProps.OutputFormatLastError));
            }
        }

        if (_failedBlocks.Any() || _retriedBlocks.Any())
        {
            _showFailedBlocksBanner = true;
            Logger.LogInformation(
                "Found {FailedCount} failed and {RetriedCount} retried blocks after workflow upload",
                _failedBlocks.Count,
                _retriedBlocks.Count);
        }
    }

    private void ClearFailedBlocksBanner()
    {
        _failedBlocks.Clear();
        _retriedBlocks.Clear();
        _showFailedBlocksBanner = false;
    }

    private string BannerSummary()
    {
        if (_failedBlocks.Any() && _retriedBlocks.Any())
        {
            return $"{_failedBlocks.Count} block(s) failed and {_retriedBlocks.Count} retried during execution";
        }

        if (_failedBlocks.Any())
        {
            return $"{_failedBlocks.Count} block(s) failed during execution";
        }

        return $"{_retriedBlocks.Count} block(s) needed a retry during execution";
    }

    private async Task ScrollToFailedBlock(Block block)
    {
        if (block.SectionId is null)
        {
            Logger.LogWarning("Cannot scroll to block: SectionId is null");
            return;
        }

        try
        {
            await _workflowInteraction.OpenBlockInEditorAsync(block);

            Logger.LogInformation(
                "Navigated to failed block at {Location}",
                GetBlockLocationString(block));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to scroll to block {BlockId}", block.Id);
            AppState.Notify(
                "Failed to navigate to block",
                Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WatchEditActivityAsync();
        }

        if (firstRender && await CanUseAgentAsync() && !string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId))
        {
            if (await TryReadAgentModeAsync())
            {
                await SetAgentModeAsync(true, remember: false);
            }
        }

        if (_revealAfterAgentMode is { } block && !_isAgentMode)
        {
            _revealAfterAgentMode = null;
            await RevealBlockInEditorAsync(block);
        }
    }

    private Task SetAgentModeAsync(bool isOn)
    {
        return SetAgentModeAsync(isOn, remember: true);
    }

    /// <summary>Agent mode shows the conversation full screen over the editor.</summary>
    private async Task SetAgentModeAsync(bool isOn, bool remember)
    {
        if (isOn && (string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId) || !await CanUseAgentAsync()))
        {
            return;
        }

        if (isOn == _isAgentMode)
        {
            return;
        }

        _isAgentMode = isOn;

        if (remember)
        {
            try
            {
                await EditorAgentModePreference.WriteAsync(JsRuntime, _user.Id, isOn);
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Could not remember the Agent mode choice");
            }
        }

        StateHasChanged();
    }

    private async Task<bool> CanUseAgentAsync()
    {
        AuthenticationState? authentication = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        return EditorAgentAccess.CanUse(authentication?.User, AgentService);
    }

    private async Task<bool> TryReadAgentModeAsync()
    {
        try
        {
            return await EditorAgentModePreference.ReadAsync(JsRuntime, _user.Id);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not read the Agent mode choice");
            return false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();

        await StopWatchingEditActivityAsync();

        _selfReference?.Dispose();
    }
}
