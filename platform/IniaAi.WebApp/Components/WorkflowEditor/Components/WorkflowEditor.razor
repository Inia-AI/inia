<style>
    .floating-button-json-save,
    .floating-button-bundle-export,
    .floating-button-db-save {
        position: fixed;
        bottom: 20px;
        z-index: 1000;
        box-shadow: var(--mud-elevation-4);
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .floating-button-json-save:hover,
    .floating-button-bundle-export:hover,
    .floating-button-db-save:hover {
        transform: scale(1.1);
        box-shadow: var(--mud-elevation-8);
    }

    .floating-button-json-save {
        right: 20px;
    }

    .floating-button-bundle-export {
        right: 100px;
    }

    .floating-button-db-save {
        right: 180px;
    }
</style>

@if (!string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId))
{
    <SectionContent SectionName="@LayoutSections.APP_BAR_ACTIONS">
        <EditorAgentEntry IsOn="_isAgentMode" IsOnChanged="SetAgentModeAsync" UserId="@_user.Id" />
    </SectionContent>
}

@* Agent mode covers the editor with the conversation; the editor stays loaded underneath so
   accepted changes land on it and "Open in editor" can return to a block. *@
<div class="editor-agent-underlay" inert="@_isAgentMode">
<MudCard Outlined="true" Class="mb-2">
    <MudCardContent>
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.UploadFile"
                       OnClick="@(async () => await _workflowFileUpload.OpenFilePickerAsync())">
                Upload from file
            </MudButton>

            <AuthorizeView Roles="@Roles.EDITOR_ROLES">
                <MudButton Variant="Variant.Text"
                           Class="editor-soft-button"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Outlined.Unarchive"
                           OnClick="@(async () => await _bundleFileUpload.OpenFilePickerAsync())">
                    Import bundle
                </MudButton>
            </AuthorizeView>

            <MudButton Variant="Variant.Text"
                       Class="editor-soft-button"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.Download"
                       OnClick="@(async() => await DownloadAsJson())">
                Download to file
            </MudButton>

            <AuthorizeView Roles="@Roles.EDITOR_ROLES">
                <MudTooltip Text="@(_headVersion is null ? "Save the workflow first — a bundle exports the last saved version" : "Export the template and its shared components for another deployment")">
                    <MudButton Variant="Variant.Text"
                               Class="editor-soft-button"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Outlined.Inventory2"
                               Disabled="@(_headVersion is null || _isExportingBundle)"
                               OnClick="@(async() => await ExportBundleAsync())">
                        Export bundle
                    </MudButton>
                </MudTooltip>
            </AuthorizeView>

            <MudButton Variant="Variant.Text"
                       Class="editor-soft-button"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.Save"
                       Disabled="@_isSavingCore"
                       OnClick="async() => await SaveCoreWorkflow(withPreviewGeneration: true)">
                Save
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Class="editor-soft-button"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.ContentCopy"
                       OnClick="async() => await CopyWorkflowAsText()">
                Copy as text
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Class="editor-soft-button"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.History"
                       OnClick="ToggleHistoryDrawer">
                Version history
            </MudButton>

            <MudBadge Content="@ReconcileAttentionCount"
                      Color="Color.Warning"
                      Overlap="true"
                      Visible="@(ReconcileAttentionCount > 0)">
                <MudButton Variant="Variant.Text"
                           Class="editor-soft-button"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Outlined.LibraryBooks"
                           Disabled="@(_restoredVersion is not null)"
                           OnClick="ToggleReconcileDrawer">
                    Library sync
                </MudButton>
            </MudBadge>

            <MudMenu Icon="@Icons.Material.Outlined.MoreVert"
                     AriaLabel="More actions"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Dense="true">
                <MudMenuItem Icon="@Icons.Material.Outlined.SaveAs"
                             OnClick="async() => await SaveCoreWorkflow(withPreviewGeneration: false)">
                    Save without regenerating previews
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <MudMenuItem Icon="@Icons.Material.Outlined.FormatListBulleted"
                             OnClick="ToggleCitationsForAll">
                    @CitationsToggleLabel
                </MudMenuItem>

                <MudMenuItem Icon="@Icons.Material.Outlined.RestartAlt"
                             OnClick="ClearAllExecutionStates">
                    Clear execution states now
                </MudMenuItem>

                <MudMenuItem Icon="@(_clearExecutionStatesBeforeRun ? Icons.Material.Outlined.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)"
                             AutoClose="false"
                             OnClick="@(() => _clearExecutionStatesBeforeRun = !_clearExecutionStatesBeforeRun)">
                    Clear execution states before each run
                </MudMenuItem>

                <MudDivider Class="my-1" />

                @if (IsGitHubSaveEnabled())
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.CloudUpload"
                                 Disabled="@_gitSaving"
                                 OnClick="CommitWorkflowToGitHub">
                        Commit to GitHub
                    </MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Outlined.SmartDisplay"
                             OnClick="async() => await ConvertToDemoWorkflow()">
                    Convert to demo
                </MudMenuItem>

                <MudMenuItem Icon="@Icons.Material.Outlined.Output"
                             OnClick="async() => await ExposeAllBlocksAsOutputs()">
                    Show all block results in report
                </MudMenuItem>

                <MudMenuItem Icon="@Icons.Material.Outlined.StopCircle"
                             OnClick="async() => await SetEveryBlockToStopTheRunAsync()">
                    @SET_EVERY_BLOCK_TO_STOP_THE_RUN
                </MudMenuItem>
            </MudMenu>
        </MudStack>

        <UnsavedChangesGuard IsDirty="_hasUnsavedChanges" IsDirtyNow="HasUnsavedChanges" />

        @if (_headVersion is not null || _hasUnsavedChanges)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                @if (_headVersion is not null)
                {
                    <VersionStamp Verb="Last saved"
                                  When="_headVersion.CreatedAtUtc"
                                  Author="@_headVersion.CreatedByName"
                                  VersionCode="@_headVersion.ShortCode" />
                }

                @if (_hasUnsavedChanges)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ma-0">Unsaved changes</MudChip>
                }
            </MudStack>
        }

        <div class="mt-4">
            <MudTextField T="string"
                          @bind-Value="EditorContext.Workflow.Title"
                          Variant="Variant.Text"
                          Margin="Margin.Dense"
                          Underline="false"
                          Placeholder="Report title"
                          aria-label="Report title"
                          Class="editor-report-title" />

            <MudTextField T="string"
                          @bind-Text="EditorContext.Workflow.Name"
                          Variant="Variant.Text"
                          Margin="Margin.Dense"
                          Underline="false"
                          Placeholder="Workflow name"
                          aria-label="Workflow name"
                          Class="editor-report-name" />

            <MudTextField T="string"
                          @bind-Text="EditorContext.Workflow.Description"
                          Variant="Variant.Text"
                          Margin="Margin.Dense"
                          Underline="false"
                          Placeholder="Description (shown for each run on the Executed Workflows page)"
                          aria-label="Workflow description"
                          Class="editor-report-description" />

            <MudTextField T="string"
                          @bind-Text="EditorContext.Workflow.Notes"
                          Variant="Variant.Text"
                          Margin="Margin.Dense"
                          Underline="false"
                          Sizing="InputSizing.Auto"
                          MaxLines="12"
                          Placeholder="Workflow notes: what this workflow is for and how it should work (the workflow agent reads and updates them)"
                          aria-label="Workflow notes"
                          data-testid="editor-workflow-notes"
                          Class="editor-report-description" />
        </div>

        <div class="d-none">
            <MudFileUpload @ref="_workflowFileUpload"
                           T="IReadOnlyList<IBrowserFile>"
                           FilesChanged="async(files) => await UploadWorkflowFileAsync(files)"
                           Accept=".sequence, .workflow"
                           MaximumFileCount="1" />
            <AuthorizeView Roles="@Roles.EDITOR_ROLES">
                <MudFileUpload @ref="_bundleFileUpload"
                               T="IReadOnlyList<IBrowserFile>"
                               FilesChanged="async(files) => await UploadWorkflowFileAsync(files, fromBundleMouth: true)"
                               Accept="@TransferBundleFile.UPLOAD_ACCEPT"
                               MaximumFileCount="1" />
            </AuthorizeView>
        </div>
    </MudCardContent>
</MudCard>

@if (_showHistory && !string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId))
{
    @* Keyed on the head version so a save while the drawer is open recreates it with a
       fresh list; otherwise it keeps showing the pre-save history and the wrong Current marker. *@
    <WorkflowHistoryDrawer @key="@(_headVersion?.Id ?? string.Empty)"
                           OrganizationId="@_user.OrganizationId"
                           WorkflowTypeId="@EditorContext.WorkflowTypeId"
                           OnLoadVersion="HandleRestoreVersion"
                           OnClose="@(() => _showHistory = false)" />
}

@if (_showReconcile && !string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId))
{
    @* Keyed on the head version for the same reason as the history drawer: a save while it is
       open would otherwise leave it holding stale decision tokens. *@
    <LibraryReconcileDrawer @key="@(_headVersion?.Id ?? string.Empty)"
                            OrganizationId="@_user.OrganizationId"
                            UserId="@_user.Id"
                            WorkflowTypeId="@EditorContext.WorkflowTypeId"
                            Workflow="@EditorContext.Workflow"
                            HasUnsavedEditorChanges="IsEditorDirtyAgainstHead"
                            OnApplied="HandleReconcileAppliedAsync"
                            OnClose="@(() => _showReconcile = false)" />
}

@if (!_brokenLinkNoticeDismissed && BrokenLibraryLinkCount > 0)
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined"
              Dense="false"
              Class="my-4"
              ShowCloseIcon="true"
              CloseIconClicked="@(() => _brokenLinkNoticeDismissed = true)"
              aria-label="Library links that this deployment cannot resolve">
        <MudText Typo="Typo.body1">
            @(BrokenLibraryLinkCount == 1
                ? "One block or section here links to a Library component this deployment does not have."
                : $"{BrokenLibraryLinkCount} blocks or sections here link to Library components this deployment does not have.")
            A plain workflow file carries the links but not the components themselves — moving the
            workflow again with <strong>Export bundle</strong> brings them along and reconnects the copies.
            To keep this workflow as it is instead, break the copies out from Library sync and they
            become ordinary local content.
        </MudText>
    </MudAlert>
}

@if (_restoredVersion is not null)
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Filled"
              Dense="false"
              Class="my-4"
              aria-label="Viewing an older saved version">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap">
            <MudText Typo="Typo.body1">
                Viewing saved version @_restoredVersion.ShortCode from @_restoredVersion.CreatedAtUtc.ToString("d MMMM yyyy HH:mm") UTC.
                This is not the current version. Save to make it current, or reload the page to discard it.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Save"
                       OnClick="async() => await SaveCoreWorkflow(withPreviewGeneration: false)">
                Save now
            </MudButton>
        </MudStack>
    </MudAlert>
}

@if (_showFailedBlocksBanner && (_failedBlocks.Any() || _retriedBlocks.Any()))
{
    <MudAlert Severity="@(_failedBlocks.Any() ? Severity.Error : Severity.Warning)"
              Variant="Variant.Filled"
              Dense="false"
              ShowCloseIcon="true"
              CloseIconClicked="@(() => ClearFailedBlocksBanner())"
              Class="my-4"
              aria-label="Warning: some blocks needed attention during execution">
        <MudText Typo="Typo.h6" Class="mb-2">
            <span role="img" aria-label="Warning" class="me-1">⚠️</span>
            @BannerSummary()
        </MudText>
        <MudExpansionPanels Dense="true">
            @if (_failedBlocks.Any())
            {
                <MudExpansionPanel Text="@($"View Failed Blocks ({_failedBlocks.Count})")" Dense="true">
                    <MudList T="string" Dense="true" ReadOnly="true">
                        @foreach (var (block, location, errorMessage) in _failedBlocks)
                        {
                            <MudListItem T="string">
                                <MudStack Spacing="1">
                                    <MudLink OnClick="@(async () => await ScrollToFailedBlock(block))"
                                             Underline="Underline.Hover"
                                             Color="Color.Error"
                                             Style="cursor: pointer; font-weight: 600;">
                                        @location
                                    </MudLink>
                                    <MudText Typo="Typo.body2" Color="Color.Default" Style="font-size: 0.875rem; opacity: 0.8;">
                                        Error: @errorMessage
                                    </MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                </MudExpansionPanel>
            }

            @if (_retriedBlocks.Any())
            {
                <MudExpansionPanel Text="@($"View Retried Blocks ({_retriedBlocks.Count})")" Dense="true">
                    <MudList T="string" Dense="true" ReadOnly="true">
                        @foreach (var (block, location, firstAttemptError) in _retriedBlocks)
                        {
                            <MudListItem T="string">
                                <MudStack Spacing="1">
                                    <MudLink OnClick="@(async () => await ScrollToFailedBlock(block))"
                                             Underline="Underline.Hover"
                                             Color="Color.Warning"
                                             Style="cursor: pointer; font-weight: 600;">
                                        @location
                                    </MudLink>
                                    <MudText Typo="Typo.body2" Color="Color.Default" Style="font-size: 0.875rem; opacity: 0.8;">
                                        Recovered after one retry. First attempt: @firstAttemptError
                                    </MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudAlert>
}

@* IsFixed on the last-touched dictionary: no per-render change notifications to every
   BlockInteraction. It changes after a save, but every save path ends in a full subtree
   re-render, so consumers pull the fresh value through normal parameter flow.
   The link index must NOT be fixed: RefreshVersionInfoAsync awaits before assigning it,
   so the first render publishes null, and WorkflowMap is one long-lived instance created
   during that render — fixing the cascade would strand it on null for the session. *@
<CascadingValue Value="_blocksLastTouched" IsFixed="true">
    <CascadingValue Name="LibraryLinkIndex" Value="_linkIndex">
        <CascadingValue Value="_editorSurfaceState" IsFixed="true">
            <WorkflowInteraction @ref="@_workflowInteraction"
                                 ShouldClearExecutionStates="@_clearExecutionStatesBeforeRun"
                                 VariablesChangedCallback="@VariablesChangedCallback"
                                 DocumentProcessingCallback="@DocumentProcessingCallback"
                                 UpdateDocumentClassesListCallback="@(this.AsNonRenderingEventHandler(UpdateDocumentClassesList))"
                                 ShareBlockToLibraryCallback="@ShareBlockToLibraryAsync"
                                 ShareSectionToLibraryCallback="@ShareSectionToLibraryAsync"
                                 RemoveLinkedEntryCallback="@RemoveLinkedSectionEntryAsync"
                                 OpenLibrarySyncCallback="@ToggleReconcileDrawer"
                                 InsertBlockFromLibraryCallback="@InsertBlockFromLibraryAsync"
                                 InsertSectionFromLibraryCallback="@InsertSectionFromLibraryAsync"/>

            <DependencySlideOver @ref="_dependencySlideOver"
                                 RevealBlock="RevealBlockInEditorAsync" />
        </CascadingValue>
    </CascadingValue>
</CascadingValue>
</div>

@if (_isAgentMode)
{
    <EditorAgentPanel @ref="_agentPanel"
                      OrganizationId="@_user.OrganizationId"
                      UserId="@_user.Id"
                      WorkflowTypeId="@EditorContext.WorkflowTypeId"
                      WorkflowName="@(string.IsNullOrWhiteSpace(EditorContext.Workflow.Title) ? EditorContext.Workflow.Name : EditorContext.Workflow.Title)"
                      CurrentWorkflow="@(() => EditorContext.Workflow)"
                      OpenBlock="OpenBlockFromAgentAsync"
                      OnWorkflowEdited="HandleAgentWorkflowEditedAsync"
                      OnProposedChanged="@(ids => _editorSurfaceState.SetProposedByAgent(ids))"
                      OnPreviewChanged="@(preview => _editorSurfaceState.SetAgentPreview(preview))"
                      OnClose="@(() => SetAgentModeAsync(false))" />
}

<MudFab Class="floating-button-json-save"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Download"
        Size="Size.Large"
        aria-label="Download workflow to file"
        title="Download workflow to file"
        OnClick="async() => await DownloadAsJson()" />

<AuthorizeView Roles="@Roles.EDITOR_ROLES">
    <MudFab Class="floating-button-bundle-export"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Inventory2"
            Size="Size.Large"
            aria-label="Export workflow bundle"
            title="Export workflow bundle"
            Disabled="@(_headVersion is null || _isExportingBundle)"
            OnClick="async() => await ExportBundleAsync()" />
</AuthorizeView>

<MudFab Class="floating-button-db-save"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Backup"
        Size="Size.Large"
        aria-label="Save workflow"
        title="Save workflow"
        Disabled="@_isSavingCore"
        OnClick="async() => await SaveCoreWorkflow(withPreviewGeneration: false)" />

@code {
    private const long MAX_FILE_SIZE_BYTES = 1024 * 1024 * 100; // 100 MiB
    private const string SAVE_CANCELLED_MESSAGE = "Save cancelled. Your changes stay in the editor, unsaved.";
    private const string EDIT_ACTIVITY_MODULE_PATH = "js/edit-activity.js";
    private const string SET_EVERY_BLOCK_TO_STOP_THE_RUN = "Set every block to stop the run";
    private const string SAVE_TO_KEEP_THE_CHANGE = "Save the workflow to keep the change.";

    private static readonly DialogOptions _smallDialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
    };

    private WorkflowInteraction _workflowInteraction = default!;
    private bool _hasUnsavedChanges;
    private string? _storedContentHash;
    private string? _checkedFingerprint;
    private DotNetObjectReference<WorkflowEditor>? _selfReference;
    private IJSObjectReference? _editActivityWatch;
    private bool _disposed;
    private DependencySlideOver? _dependencySlideOver;
    private readonly EditorSurfaceState _editorSurfaceState = new(EditorSurfaceCapabilities.FullEditor);
    private MudFileUpload<IReadOnlyList<IBrowserFile>> _workflowFileUpload = default!;
    private MudFileUpload<IReadOnlyList<IBrowserFile>> _bundleFileUpload = default!;
    private List<string> _documentClasses = [];
    private User _user = default!;
    private WorkflowVersionSummaryDto? _headVersion;
    private string? _headRebuiltContentHash;
    private WorkflowVersionContentDto? _restoredVersion;
    private string? _baseVersionId;
    private IReadOnlyDictionary<string, BlockLastTouchedDto>? _blocksLastTouched;
    private LibraryLinkIndex? _linkIndex;
    private bool _showHistory;
    private bool _showReconcile;
    private bool _brokenLinkNoticeDismissed;
    private bool _gitSaving;
    private bool _isSavingCore;
    private bool _isExportingBundle;
    private readonly CancellationTokenSource _cts = new();
    private string _lastCommitMessage = string.Empty;
    private List<(Block block, string location, string errorMessage)> _failedBlocks = [];
    private List<(Block block, string location, string firstAttemptError)> _retriedBlocks = [];
    private bool _showFailedBlocksBanner = false;
    private bool _isUploadedFromFile = false;
    private bool _clearExecutionStatesBeforeRun = true;
    private bool _isAgentMode;
    private Block? _revealAfterAgentMode;
    private EditorAgentVersionNote _agentVersionNote = default!;
    private EditorAgentPanel? _agentPanel;


    [CascadingParameter(Name = "EditorContext")]
    public WorkflowEditorContext EditorContext { get; set; } = default!;

    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter, EditorRequired]
    public EventCallback DocumentProcessingCallback { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<List<string>> DocumentClassesChangedCallBack { get; set; }

    [Parameter]
    public EventCallback VariablesChangedCallback { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ArgumentNullException.ThrowIfNull(AppState.User, nameof(AppState.User));

        _user = AppState.User;
        _agentVersionNote = new EditorAgentVersionNote(AgentService, _user.OrganizationId, _user.Id);

        await RefreshVersionInfoAsync();
        _baseVersionId = _headVersion?.Id;
    }

    protected override void OnParametersSet()
    {
        UpdateDocumentClassesList();
    }

    private async Task RefreshVersionInfoAsync()
    {
        if (string.IsNullOrWhiteSpace(EditorContext.WorkflowTypeId))
        {
            _headVersion = null;
            _blocksLastTouched = null;
            _linkIndex = null;
            return;
        }

        await Task.WhenAll(RefreshLinkIndexAsync(), RefreshSaveStateAsync());
    }

    private async Task RefreshLinkIndexAsync()
    {
        ErrorOr<List<SharedComponentSummaryDto>> components = await ServiceScopeFactory.SendScopedAsync(
            new ListSharedComponentsQuery(_user.OrganizationId, _user.Id));
        _linkIndex = components.IsError ? null : new LibraryLinkIndex(components.Value);

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSaveStateAsync()
    {
        using IServiceScope scope = ServiceScopeFactory.CreateScope();
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();

        ErrorOr<WorkflowHistoryPageDto> history = await sender.Send(
            new GetWorkflowHistoryQuery(_user.OrganizationId, EditorContext.WorkflowTypeId, Take: 1));
        if (history.IsError)
        {
            AppState.Notify(
                $"Could not read this template's version state: {history.FirstError.Description} " +
                "Saving may report a false conflict until it loads.",
                Severity.Warning);
        }

        _headVersion = history.IsError ? null : history.Value.Versions.FirstOrDefault();
        _headRebuiltContentHash = await RebuiltHeadContentHashAsync(sender);

        ErrorOr<IReadOnlyDictionary<string, BlockLastTouchedDto>> blocks = await sender.Send(
            new GetAllBlocksLastTouchedQuery(_user.OrganizationId, EditorContext.WorkflowTypeId));
        _blocksLastTouched = blocks.IsError ? null : blocks.Value;

        _storedContentHash = LiveContentHash();
        _checkedFingerprint = null;
        RecheckUnsavedChanges();
    }

