            + $"Excluded from every bundle — {string.Join("; ", export.Value.SkippedCarriers)} — "
            + "none of these travel with the file.",
            Severity.Success);
    }

    private bool IsEditorDirtyAgainstHead()
    {
        if (_headVersion is null)
        {
            return false;
        }

        string liveHash = LiveContentHash();

        return !string.Equals(liveHash, _headVersion.ContentHash, StringComparison.Ordinal)
            && !string.Equals(liveHash, _headRebuiltContentHash, StringComparison.Ordinal);
    }

    /// <summary>
    /// Leaving loses work only when the editor holds content that is neither the stored template,
    /// as last loaded or saved, nor the newest saved version. The stored template can differ from
    /// that version when something other than the editor wrote it.
    /// </summary>
    private bool HasUnsavedChanges()
    {
        if (_storedContentHash is null)
        {
            return false;
        }

        string liveHash = LiveContentHash();
        bool matchesNewestVersion = _headVersion is not null
            && (string.Equals(liveHash, _headVersion.ContentHash, StringComparison.Ordinal)
                || string.Equals(liveHash, _headRebuiltContentHash, StringComparison.Ordinal));

        return !matchesNewestVersion && !string.Equals(liveHash, _storedContentHash, StringComparison.Ordinal);
    }

    /// <summary>
    /// Runs after each pause in the author's activity, so it skips the full content hash when the
    /// workflow has not changed since the last check; a save or a load clears the fingerprint.
    /// </summary>
    [JSInvokable]
    public void RecheckUnsavedChanges()
    {
        string fingerprint = new WorkflowCanonicalizer().ComputeChangeFingerprint(EditorContext.Workflow);
        if (fingerprint == _checkedFingerprint)
        {
            return;
        }

        _checkedFingerprint = fingerprint;
        bool hasUnsavedChanges = HasUnsavedChanges();
        if (hasUnsavedChanges != _hasUnsavedChanges)
        {
            _hasUnsavedChanges = hasUnsavedChanges;
            StateHasChanged();
        }
    }

    private async Task WatchEditActivityAsync()
