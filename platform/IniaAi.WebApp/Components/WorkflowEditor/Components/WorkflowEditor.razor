    private async Task ApplyLoadedWorkflowAsync(Workflow restored)
    {
        WorkflowEditorContext.NormalizeParameterizedSections(restored);
        EditorContext.Workflow = restored;

        // Renames recorded against the discarded tree must not re-key live override rows on
        // the next save — the replacement tree does not carry the token rewrites they paired with.
        EditorContext.PendingSignatureFieldRenames.Clear();
        _editorSurfaceState.ClearChangedByAgent();

        UpdateDocumentClassesList();
        await _workflowInteraction.UpdateWorkflowStateAsync();
        await VariablesChangedCallback.InvokeAsync();
        _dependencySlideOver?.ScheduleRefresh();
    }

