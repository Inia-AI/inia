    /// <summary>
    /// The agent changed the live workflow in memory: the changed blocks re-render, marked as
    /// changed by the agent until the next save, and an undo takes the marks back.
    /// </summary>
    private async Task HandleAgentWorkflowEditedAsync(EditorAgentWorkflowEdit edit)
    {
        if (edit.Undone && edit.ChangedStableIds.Count > 0)
        {
            _editorSurfaceState.UnmarkChangedByAgent(edit.ProposalId, edit.ChangedStableIds);
        }
        else if (edit.Undone)
        {
            _editorSurfaceState.UnmarkChangedByAgent(edit.ProposalId);
        }
        else
        {
            _editorSurfaceState.MarkChangedByAgent(edit.ProposalId, edit.ChangedStableIds);
            _agentVersionNote.NoteAccepted();
        }

        UpdateDocumentClassesList();
        await _workflowInteraction.UpdateWorkflowStateAsync();
        await VariablesChangedCallback.InvokeAsync();
        _dependencySlideOver?.ScheduleRefresh();
    }

