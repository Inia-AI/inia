        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not watch for edits; the unsaved-changes marker updates only on load and save");
        }

        if (_disposed)
        {
            await StopWatchingEditActivityAsync();
        }
    }

    private async Task StopWatchingEditActivityAsync()
    {
        try
        {
            if (_editActivityWatch is not null)
            {
                await _editActivityWatch.InvokeVoidAsync("dispose");
                await _editActivityWatch.DisposeAsync();
                _editActivityWatch = null;
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException)
        {
            // Blazor cancels pending interop calls once the browser has gone, and the page with it.
        }
    }

