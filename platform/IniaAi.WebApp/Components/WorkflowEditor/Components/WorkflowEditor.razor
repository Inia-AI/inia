    private async Task ShareBlockToLibraryAsync(Block block)
    {
        Section? container = block.Section?.IsActivelyLinked() == true ? block.Section : null;

        await ShareToLibraryAsync("block", block.Name, () => block.StableBlockId, container, block);
    }

    private async Task ShareSectionToLibraryAsync(Section section)
    {
        await ShareToLibraryAsync("section", section.Title, () => section.StableSectionId);
    }

    private async Task ShareToLibraryAsync(
        string subjectKind,
        string? subjectName,
        Func<string?> stableId,
        Section? linkedContainer = null,
        Block? linkedBlock = null)
    {
        if (!await SaveCoreWorkflow(withPreviewGeneration: false))
        {
            return;
        }

        // Only a block the section's definition provides converts into a reference there; a block
        // added locally is nobody else's business and shares as an ordinary component, so promising
        // the whole Library will follow would be a lie.
        string? containerName = linkedContainer is null
            || (linkedBlock is not null && !await IsDefinitionProvidedAsync(linkedContainer, linkedBlock))
            ? null
            : _linkIndex?.For(linkedContainer).ComponentName ?? linkedContainer.Title;
        ShareToLibraryDialog.ShareToLibraryResult? share = await PromptShareDetailsAsync(
            subjectKind, subjectName, containerName);
        if (share is null)
        {
            return;
        }

        string? containerToken = linkedContainer?.SharedComponentId is { } containerComponentId
            ? _linkIndex?.HeadVersionIdFor(containerComponentId)
            : null;
        await DispatchPromoteAsync(stableId(), share, subjectKind, containerToken);
    }

    private async Task RemoveLinkedSectionEntryAsync(Block block)
    {
        Section? section = block.Section;
        if (section is null || !section.IsActivelyLinked())
        {
            _editorSurfaceState.RemoveBlock(block);

            return;
        }

        ErrorOr<WorkflowSharedComponentReconcileResult> reconcile = await ServiceScopeFactory.SendScopedAsync(
            new GetWorkflowSharedComponentReconcileQuery(
                _user.OrganizationId, _user.Id, EditorContext.WorkflowTypeId));
        if (reconcile.IsError)
        {
            AppState.Notify(
                $"Could not check the Library state of '{block.Name}' — nothing was removed. Try again.",
                Severity.Error);

            return;
        }

        SharedComponentEntryReconcileRow? entry = block.StableBlockId is null
            ? null
            : reconcile.Value.Instances
                .FirstOrDefault(row => string.Equals(
                    row.TargetStableId, section.StableSectionId, StringComparison.Ordinal))
                ?.Entries
                ?.FirstOrDefault(e => string.Equals(
                    e.EntryStableId, block.StableBlockId, StringComparison.Ordinal));

        if (!LibraryReconcilePlanner.RequiresHideConfirmation(entry))
        {
            _editorSurfaceState.RemoveBlock(block);

            return;
        }

        string sectionComponentName = _linkIndex?.For(section).ComponentName ?? section.Title ?? "the Library";
        if (!await ConfirmHideEntryAsync(block.Name ?? entry!.DisplayName, sectionComponentName))
        {
            return;
        }

        await HideEntryAsync(section, block);
    }

    private async Task<bool> ConfirmHideEntryAsync(string blockName, string sectionComponentName)
    {
        var parameters = new DialogParameters<HideEntryConfirmDialog>
        {
            { dialog => dialog.BlockName, blockName },
            { dialog => dialog.SectionComponentName, sectionComponentName },
        };
        IDialogReference dialog = await DialogService.ShowAsync<HideEntryConfirmDialog>(
            "Hide Library entry?",
            parameters,
            _smallDialogOptions);
        DialogResult? result = await dialog.Result;

        return result is not null && !result.Canceled;
    }

    private async Task HideEntryAsync(Section section, Block block)
    {
        if (!await SaveCoreWorkflow(withPreviewGeneration: false) || _baseVersionId is null)
        {
            return;
        }

        ErrorOr<SharedComponentReconcileApplyResult> result = await ServiceScopeFactory.SendScopedAsync(
            new ApplySharedComponentReconcileCommand(
                _user.OrganizationId,
                _user.Id,
                EditorContext.WorkflowTypeId,
                _baseVersionId,
                [
                    new SharedComponentReconcileDecision(
                        section.SharedComponentId!,
                        TargetStableId: section.StableSectionId,
                        TargetPath: null,
                        Action: SharedComponentReconcileAction.Hide,
                        EntryStableId: block.StableBlockId),
                ]));

        if (result.IsError)
        {
            AppState.Notify(
                $"Could not hide '{block.Name}': {result.FirstError.Description}"
                + " Open Library sync to review and retry.",
                Severity.Error);

            return;
        }

        AppState.Notify($"'{block.Name}' is now hidden in this workflow.", Severity.Success);
        string? anchorVersionId = result.Value.WorkflowSaves
            .FirstOrDefault(save => string.Equals(
                save.WorkflowTypeId, EditorContext.WorkflowTypeId, StringComparison.Ordinal))
            ?.VersionId;
        await LoadLatestSavedVersionAsync(anchorVersionId, quiet: true);
    }

    private async Task<bool> IsDefinitionProvidedAsync(Section section, Block block)
    {
        if (block.StableBlockId is null)
        {
            return false;
        }

        ErrorOr<WorkflowSharedComponentReconcileResult> reconcile = await ServiceScopeFactory.SendScopedAsync(
            new GetWorkflowSharedComponentReconcileQuery(
                _user.OrganizationId, _user.Id, EditorContext.WorkflowTypeId));
        if (reconcile.IsError)
        {
            return false;
        }

        SharedComponentEntryReconcileRow? entry = reconcile.Value.Instances
            .FirstOrDefault(row => string.Equals(
                row.TargetStableId, section.StableSectionId, StringComparison.Ordinal))
            ?.Entries
            ?.FirstOrDefault(e => string.Equals(
                e.EntryStableId, block.StableBlockId, StringComparison.Ordinal));

        return entry is not null && entry.Origin != SharedComponentEntryOrigin.LocalInsert;
    }

    private async Task<ShareToLibraryDialog.ShareToLibraryResult?> PromptShareDetailsAsync(
        string subjectKind,
        string? defaultName,
        string? linkedContainerName = null)
    {
        List<SharedComponentCategoryDto> categories;
        using (IServiceScope scope = ServiceScopeFactory.CreateScope())
        {
            ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
            ErrorOr<SharedComponentCategoriesDto> vocabulary = await sender.Send(
                new ListSharedComponentCategoriesQuery(_user.OrganizationId, _user.Id));
            if (vocabulary.IsError || vocabulary.Value.Categories.Count == 0)
            {
                AppState.Notify(
                    "No Library categories exist yet — create one on the Library page first.",
                    Severity.Error);
                return null;
            }

            categories = vocabulary.Value.Categories;
        }

        var parameters = new DialogParameters<ShareToLibraryDialog>
        {
            { dialog => dialog.SubjectKind, subjectKind },
            { dialog => dialog.DefaultName, defaultName },
            { dialog => dialog.Categories, categories },
            { dialog => dialog.LinkedContainerName, linkedContainerName },
        };
        IDialogReference dialog = await DialogService.ShowAsync<ShareToLibraryDialog>(
            $"Share {subjectKind} to Library",
            parameters,
            _smallDialogOptions);
        DialogResult? result = await dialog.Result;

        return result is null || result.Canceled
            ? null
            : result.Data as ShareToLibraryDialog.ShareToLibraryResult;
    }

    private async Task DispatchPromoteAsync(
        string? targetStableId,
        ShareToLibraryDialog.ShareToLibraryResult share,
        string subjectKind,
        string? expectedContainerHeadVersionId = null)
    {
        if (string.IsNullOrEmpty(targetStableId))
        {
            AppState.Notify(
                $"Could not share the {subjectKind}: it has not been saved yet. Save the workflow and try again.",
                Severity.Error);
            return;
        }

        using IServiceScope scope = ServiceScopeFactory.CreateScope();
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
        ErrorOr<PromoteSharedComponentResult> promoted = await sender.Send(new PromoteSharedComponentCommand(
            _user.OrganizationId,
            _user.Id,
            EditorContext.WorkflowTypeId,
            TargetStableId: targetStableId,
            Name: share.Name,
            Description: share.Description,
            BaseVersionId: _baseVersionId,
            CategoryId: share.CategoryId,
            ExpectedContainerHeadVersionId: expectedContainerHeadVersionId));

        if (promoted.IsError)
        {
            AppState.Notify(
                $"Could not share the {subjectKind}: {promoted.FirstError.Description}",
                Severity.Error);
            return;
        }

        AppState.Notify(
            $"'{promoted.Value.Name}' shared to the Library.",
            Severity.Success);

        await LoadLatestSavedVersionAsync(promoted.Value.VersionId, quiet: true);
    }

    private async Task InsertBlockFromLibraryAsync((Section Section, int Index) target)
    {
        if (!await SaveCoreWorkflow(withPreviewGeneration: false))
