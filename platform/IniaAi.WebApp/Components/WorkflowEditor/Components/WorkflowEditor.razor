    private async Task<bool> SaveCoreWorkflow(bool withPreviewGeneration = true)
    {
        if (_isSavingCore)
        {
            return false;
        }

        Logger.LogInformation("Saving core workflow {WorkflowId} to database",
            EditorContext.Workflow.Id);

        // Precondition checks run before any tree mutation or user prompt, so a blocked
        // save leaves the in-editor workflow untouched and never asks the user to confirm
        // a save that cannot proceed. Expansion discards the parameterized config, so
        // saving an expanded tree as core would permanently destroy the parameterization
        // for this workflow type.
        IReadOnlyList<string> expandedSections = EditorContext.Workflow.GetExpandedParameterizedSectionTitles();
        if (expandedSections.Count > 0)
        {
            Logger.LogWarning(
                "Blocked save-as-core for workflow {WorkflowId}: contains {Count} expanded parameterized section(s)",
                EditorContext.Workflow.Id,
                expandedSections.Count);
            await ShowExpandedParameterizedBlockDialog(expandedSections);
            return false;
        }

        if (_isUploadedFromFile && HasExecutionData())
        {
            bool confirmed = await ShowSaveExecutedWorkflowConfirmationAsync();
            if (!confirmed)
            {
                Logger.LogInformation("User cancelled saving executed workflow");
                return false;
            }
        }

        _isSavingCore = true;
        try
        {
            return await SaveCoreWorkflowCoreAsync(withPreviewGeneration);
        }
        finally
        {
            _isSavingCore = false;
        }
    }

    private async Task<bool> SaveCoreWorkflowCoreAsync(bool withPreviewGeneration)
    {
        var allBlocks = EditorContext.Workflow.GetAllBlocks();
        foreach (var block in allBlocks)
        {
            block.Reset();
        }

        List<(Block block, List<string> invalidTags)> blocksWithInvalidTags = FindBlocksWithInvalidReplacementTags();

        // The editor sends SaveWorkflowCommand directly (bypassing the API's structural validation),
        // so the regression-field, signature-field and web address rules are gated here. Only errors
        // with those codes block the save; other structural rules stay API-only for the editor path.
        WorkflowStructuralValidationResult structure = StructuralValidator.Validate(EditorContext.Workflow);
        List<Error> fieldErrors = structure
            .Errors
            .Where(e => WorkflowTemplateStructuralValidator.IsRegressionError(e)
                || WorkflowTemplateStructuralValidator.IsSignatureError(e)
                || WorkflowTemplateStructuralValidator.IsWebAddressError(e)
                || WorkflowTemplateStructuralValidator.IsInputRuleError(e))
            .ToList();

        if (fieldErrors.Count > 0)
        {
            string details = string.Join("\n", fieldErrors.Select(e => $"• {e.Description}"));
            var messageBoxOptions = new MessageBoxOptions
            {
                Title = fieldErrors.All(WorkflowTemplateStructuralValidator.IsWebAddressError)
                    ? "A web address does not name its host"
                    : fieldErrors.Any(WorkflowTemplateStructuralValidator.IsWebAddressError)
                        ? "Some block fields are misconfigured"
                        : fieldErrors.All(WorkflowTemplateStructuralValidator.IsInputRuleError)
                            ? "An input rule is not complete"
                            : "Regression or signature fields are misconfigured",
                Message = details,
                YesText = "OK",
            };
            _ = await DialogService.ShowMessageBoxAsync(messageBoxOptions, _smallDialogOptions);
            return false;
        }

        if (withPreviewGeneration)
        {
            await PromptForPreviewGenerationForBlocks();
        }

        bool saved = await SendVersionedSaveAsync(_baseVersionId, allowConflictRecovery: true);

        if (saved)
        {
            foreach (WorkflowStructuralValidationWarning staleRule in structure.Warnings.Where(WorkflowTemplateStructuralValidator.IsInputRuleWarning))
            {
                AppState.Notify(staleRule.Message, Severity.Warning);
            }
        }

        // The warning says the workflow was saved, so it waits for the save to succeed.
        if (saved && blocksWithInvalidTags.Count > 0)
        {
            await ShowConsolidatedValidationWarningDialog(blocksWithInvalidTags);
        }

        return saved;
    }

    private async Task<bool> SendVersionedSaveAsync(
        string? baseVersionId,
        bool allowConflictRecovery,
        bool confirmSignatureFieldDeletions = false)
    {
        // A fresh DI scope keeps the save handler's DbContext clear of the editor circuit's tracking state.
        using IServiceScope scope = ServiceScopeFactory.CreateScope();
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();

        string? agentNote = await _agentVersionNote.BeforeSaveAsync(EditorContext.WorkflowTypeId);

        ErrorOr<SaveWorkflowResult> saveResult = await sender.Send(new SaveWorkflowCommand(
            _user.OrganizationId,
            _user.Id,
            EditorContext.WorkflowTypeId,
            EditorContext.Workflow,
            baseVersionId,
            EnforceOptimisticConcurrency: true,
            SignatureFieldRenames: [.. EditorContext.PendingSignatureFieldRenames],
            ConfirmSignatureFieldDeletions: confirmSignatureFieldDeletions,
            VersionNote: agentNote));

        if (saveResult.IsError)
        {
            if (allowConflictRecovery && SaveWorkflowCommandHandler.IsVersionConflict(saveResult.FirstError))
            {
                return await RecoverFromSaveConflictAsync(saveResult.FirstError);
            }

            // The server refuses a save that deletes client signature overrides until the author
            // confirms: show its dialog, and on confirm retry the save with the confirmation set.
            async Task<bool> ConfirmRefusalAsync(string title, string yesText)
            {
                var confirmOptions = new MessageBoxOptions
                {
                    Title = title,
                    Message = saveResult.FirstError.Description,
                    YesText = yesText,
                    CancelText = "Keep editing",
                };
                bool? proceed = await DialogService.ShowMessageBoxAsync(confirmOptions, _smallDialogOptions);
                if (proceed is not true)
                {
                    AppState.Notify(SAVE_CANCELLED_MESSAGE, Severity.Info);
                }

                return proceed is true;
            }

            // Uploads and version restores reach the delete path without the Signatures tab's
            // confirmation dialog, so the server refuses and the editor confirms here instead.
            if (!confirmSignatureFieldDeletions
                && saveResult.FirstError.Code == SignatureFieldSaveSynchronizer.DELETION_REQUIRES_CONFIRMATION_CODE)
            {
                if (await ConfirmRefusalAsync("This save deletes client signature overrides", "Delete and save"))
                {
                    return await SendVersionedSaveAsync(
                        baseVersionId,
                        allowConflictRecovery,
                        confirmSignatureFieldDeletions: true);
                }

                return false;
            }

            Logger.LogError(
                "Core workflow {WorkflowTypeId} save failed: {Error}",
                EditorContext.WorkflowTypeId,
                saveResult.FirstError.Description);

            AppState.Notify(
                $"Could not save the workflow: {saveResult.FirstError.Description}",
                Severity.Error);

            return false;
        }

        Logger.LogInformation(
            "Core workflow {WorkflowId} saved successfully",
            EditorContext.Workflow.Id);

        AppState.Notify(
            "Workflow saved.",
            Severity.Success);

        foreach (string saveWarning in saveResult.Value.Warnings ?? [])
        {
            AppState.Notify(saveWarning, Severity.Warning);
        }

        _baseVersionId = saveResult.Value.VersionId;
        bool agentChangesSaved = await _agentVersionNote.AfterSaveAsync(
            EditorContext.WorkflowTypeId, wroteNewVersion: !saveResult.Value.WasDeduped, saveResult.Value.VersionId);
        _editorSurfaceState.ClearChangedByAgent();
        if (agentChangesSaved && _agentPanel is not null)
        {
            await _agentPanel.RefreshAsync();
        }

        EditorContext.PendingSignatureFieldRenames.Clear();
        EditorContext.MarkSaved();

        NotifySignatureSyncIfChanged(saveResult.Value.SignatureSync);

        await RefreshVersionInfoAsync();

        // Tell every signature-aware component to drop its override cache and
        // refetch. While staff was editing, a client may have promoted a pending
        // or authored a direct override via Vue — without this kick the editor's
        // "Client Override" preview keeps showing whatever was loaded at mount.
        AppState.NotifySignatureOverridesInvalidated();

        _ = AutoCommitToGitHubAsync();

        _isUploadedFromFile = false;
        _restoredVersion = null;

        await _workflowInteraction.UpdateWorkflowStateAsync();

        return true;
    }

    private async Task<bool> RecoverFromSaveConflictAsync(Error conflict)
    {
        string? currentHeadId = SaveWorkflowCommandHandler.GetCurrentHeadVersionId(conflict);
        List<string>? revertLines = await BuildConflictRevertLinesAsync(currentHeadId);

        var parameters = new DialogParameters<SaveConflictDialog>
        {
            { dialog => dialog.RevertLines, revertLines ?? [] },
            { dialog => dialog.DiffUnavailable, revertLines is null },
        };
        IDialogReference dialogReference = await DialogService.ShowAsync<SaveConflictDialog>(
            "Template changed while you were editing",
            parameters,
            _smallDialogOptions);
        DialogResult? result = await dialogReference.Result;
        SaveConflictChoice choice = result is { Canceled: false, Data: SaveConflictChoice picked }
            ? picked
            : SaveConflictChoice.KeepEditing;

        if (choice == SaveConflictChoice.SaveMine)
        {
            string? retryBaseVersionId = currentHeadId;
            if (retryBaseVersionId is null)
            {
                await RefreshVersionInfoAsync();
                retryBaseVersionId = _headVersion?.Id;
            }

            return await SendVersionedSaveAsync(retryBaseVersionId, allowConflictRecovery: false);
        }

        if (choice == SaveConflictChoice.LoadLatest)
        {
            await LoadLatestSavedVersionAsync(currentHeadId);
            return false;
        }

        AppState.Notify(SAVE_CANCELLED_MESSAGE, Severity.Info);

        return false;
    }

    private async Task<List<string>?> BuildConflictRevertLinesAsync(string? currentHeadId)
    {
        try
        {
            if (currentHeadId is null
                || _baseVersionId is null
                || string.Equals(currentHeadId, _baseVersionId, StringComparison.Ordinal))
            {
                return null;
            }

            ErrorOr<WorkflowDiff> diff = await ServiceScopeFactory.SendScopedAsync(
                new CompareWorkflowVersionsQuery(_user.OrganizationId, _baseVersionId, currentHeadId));

            return diff.IsError ? null : SaveConflictDisclosure.BuildRevertLines(diff.Value);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not build the save-conflict revert disclosure");

            return null;
        }
    }

    private async Task LoadLatestSavedVersionAsync(string? headVersionId, bool quiet = false)
    {
        if (headVersionId is null)
        {
            await RefreshVersionInfoAsync();
            headVersionId = _headVersion?.Id;
        }

        if (headVersionId is null)
        {
            AppState.Notify("Could not determine the latest saved version to load.", Severity.Error);
            return;
        }

        using IServiceScope scope = ServiceScopeFactory.CreateScope();
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();

        ErrorOr<WorkflowVersionContentDto> content = await sender.Send(
            new GetWorkflowVersionQuery(_user.OrganizationId, headVersionId));

        if (content.IsError)
        {
            AppState.Notify(
                $"Could not load the latest saved version: {content.FirstError.Description}",
                Severity.Error);
            return;
        }

        Workflow? restored = Workflow.FromJson(content.Value.WorkflowJson);
        if (restored is null)
        {
            AppState.Notify("Could not load the latest saved version.", Severity.Error);
            return;
        }

        _isUploadedFromFile = false;
        _restoredVersion = null;
        _baseVersionId = content.Value.Id;
        await RefreshVersionInfoAsync();
        await ApplyLoadedWorkflowAsync(restored);

        if (!quiet)
        {
            AppState.Notify(
                $"Loaded the latest saved version {content.Value.ShortCode}. Your unsaved changes were discarded.",
                Severity.Info);
        }
    }

