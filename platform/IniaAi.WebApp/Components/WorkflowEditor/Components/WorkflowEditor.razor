    private async Task DispatchMaterializeAsync(
        SharedComponentSummaryDto component,
        string? targetSectionStableId,
        int index)
    {
        using IServiceScope scope = ServiceScopeFactory.CreateScope();
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
        ErrorOr<MaterializeSharedComponentResult> materialized = await sender.Send(new MaterializeSharedComponentCommand(
            _user.OrganizationId,
            _user.Id,
            EditorContext.WorkflowTypeId,
            component.Id,
            TargetSectionStableId: targetSectionStableId,
            Index: index,
            BaseVersionId: _baseVersionId));

        if (materialized.IsError)
        {
            AppState.Notify(
                $"Could not insert '{component.Name}' from the Library: {materialized.FirstError.Description}",
                Severity.Error);
            return;
        }

        if (HasMaterializeDetails(materialized.Value))
        {
            await ShowMaterializeResultAsync(component.Name, materialized.Value);
        }
        else
        {
            AppState.Notify(
                $"'{component.Name}' inserted from the Library.",
                Severity.Success);
        }

        await LoadLatestSavedVersionAsync(materialized.Value.VersionId, quiet: true);
    }

    private static bool HasMaterializeDetails(MaterializeSharedComponentResult result)
    {
        return result.Warnings.Count > 0 || SharedComponentImpactText.SlotRenames(result.Bindings).Count > 0;
    }

    private async Task ShowMaterializeResultAsync(string componentName, MaterializeSharedComponentResult result)
    {
        var parameters = new DialogParameters<MaterializeResultDialog>
        {
            { dialog => dialog.ComponentName, componentName },
            { dialog => dialog.Result, result },
        };
        IDialogReference dialog = await DialogService.ShowAsync<MaterializeResultDialog>(
            $"'{componentName}' inserted",
            parameters,
            _smallDialogOptions);
        _ = await dialog.Result;
    }

    /// <summary>
    /// Surfaces a post-save toast describing what the signature-override sync did during
    /// the save (renames carried, deletions cascaded). Stays silent on the common case
    /// (no field renames or deletions in the session).
    /// </summary>
    private void NotifySignatureSyncIfChanged(SignatureSyncResult result)
    {
        int deleted = result.OverridesDeleted + result.PendingsDeleted;
        if (result.OverridesRenamed == 0 && deleted == 0)
        {
            return;
        }

        AppState.Notify(
            $"Signatures: {result.OverridesRenamed} override(s) renamed, {deleted} cleaned up",
            Severity.Info);
    }

    private async Task PromptForPreviewGenerationForBlocks()
    {
        var blocksNeedingPreviews = PromptPreviewService
            .GetBlocksNeedingPreviews(EditorContext.Workflow);

        bool shouldGeneratePreviews = false;

        if (blocksNeedingPreviews.Any())
        {
            var parameters = new DialogParameters
            {
                ["BlockCount"] = blocksNeedingPreviews.Count,
                ["OnPreviewGeneration"] = EventCallback.Factory.Create<RegeneratePreviewsDialog>(this, async (dialogInstance) =>
                {
                    var success = await GeneratePreviewsWithProgress(blocksNeedingPreviews, dialogInstance);
                    dialogInstance.CompleteGeneration(success);
                })
            };

            var options = new DialogOptions()
            {
                CloseButton = false, // Prevent closing during generation
                MaxWidth = MaxWidth.Medium
            };

            var dialog = await DialogService.ShowAsync<RegeneratePreviewsDialog>(
                "Generate Prompt Previews?",
                parameters,
                options);

            var result = await dialog.Result;

            if (result is null)
            {
                Logger.LogError("Preview generation dialog was closed unexpectedly");
                AppState.Notify(
                    "Preview generation dialog was closed unexpectedly, saving workflow as is",
                    Severity.Error);
                return;
            }

            if (result.Canceled)
            {
                Logger.LogWarning("Preview generation was cancelled");
                AppState.Notify(
                    "Preview generation was cancelled, saving workflow as is",
                    Severity.Warning);
                return;
            }

            shouldGeneratePreviews = false;
        }

        if (shouldGeneratePreviews)
        {
            await GeneratePreviewsForBlocks(blocksNeedingPreviews);
        }
    }

    private async Task GeneratePreviewsForBlocks(List<Block> blocks)
    {
        int successCount = 0;
        int errorCount = 0;

        int maxDegreeOfParallelism = PlatformSettingsOptions.Value.IniaAi.LlmMaxDegreeOfParallelism
            ?? Environment.ProcessorCount;

        var parallelOptions = new ParallelOptions
        {
            MaxDegreeOfParallelism = maxDegreeOfParallelism
        };

        await Parallel.ForEachAsync(blocks, parallelOptions, async (block, cancellationToken) =>
        {
            if (block.Properties is not AiQueryProperties props)
            {
                Logger.LogWarning("Skipping preview generation for block {BlockId} of type {BlockType} due to incompatible properties",
                    block.Id, block.Type);
                Interlocked.Increment(ref errorCount);
                return;
            }

            var success = await TryGeneratePreviewWithRetry(props, block.ReplacementTag, maxRetries: 2);

            if (success)
            {
                Interlocked.Increment(ref successCount);
            }
            else
            {
                // Apply graceful degradation
                props.UserPromptTemplatePreview = CreateFallbackPreview(props);
                Interlocked.Increment(ref errorCount);
            }
        });

        if (successCount > 0)
        {
            Logger.LogInformation(
                "Generated {SuccessCount} prompt previews successfully",
                successCount);
            AppState.Notify(
                $"Generated {successCount} prompt previews successfully",
                Severity.Success);
        }

        if (errorCount > 0)
        {
            Logger.LogWarning(
                "Failed to generate {ErrorCount} prompt previews (used fallback)",
                errorCount);
            AppState.Notify(
                $"Failed to generate {errorCount} prompt previews (used fallback)",
                Severity.Warning);
        }
    }


    private async Task<bool> TryGeneratePreviewWithRetry(AiQueryProperties props, string blockTag, int maxRetries = 2)
    {
        var modelFamily = TenantModelFamilyResolver.GetModelFamilyForFunction(AppState.CurrentOrganizationId, IniaAi.AiConnection.Common.FunctionType.WorkflowReasoning);

        for (int attempt = 0; attempt < maxRetries; attempt++)
        {
            try
            {


                using var scope = ServiceScopeFactory.CreateScope();
                var chatConnector = scope.ServiceProvider.GetRequiredService<IChatConnector>();

                var userPrompt = $"Create a privacy-safe preview for this user prompt template:\n\n{props.UserPromptTemplate}";
                string? response = (await chatConnector
                    .GetResponseAsync(
                        userPrompt,
                        PlatformSettingsOptions.Value.PromptTemplates.UserPromptPreviewSystemPrompt,
                        family: modelFamily))
                    .GetPlainText();

                if (!string.IsNullOrWhiteSpace(response))
                {
                    props.UserPromptTemplatePreview = response.Trim();
                    return true;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Attempt {Attempt} failed for block {BlockTag}: {Error}",
                    attempt + 1, blockTag, ex.Message);

                // Exponential backoff for retry
                if (attempt < maxRetries - 1)
                {
                    await Task.Delay(1000 * (attempt + 1));
                }
            }
        }

        Logger.LogError("All {MaxRetries} attempts failed for block {BlockTag}", maxRetries, blockTag);
        return false;
    }

    private string CreateFallbackPreview(AiQueryProperties props)
    {
        // Create a basic fallback preview when AI generation fails
        var previewLength = Math.Min(150, props.UserPromptTemplate?.Length ?? 150);
        var truncatedPrompt = props.UserPromptTemplate is not null
            && props.UserPromptTemplate.Length > previewLength
                ? props.UserPromptTemplate.Substring(0, previewLength) + "..."
                : props.UserPromptTemplate;

        return $"[Preview unavailable - {nameof(BlockTypes.AiQuery)} block]: {truncatedPrompt}";
    }

    private async Task<bool> GeneratePreviewsWithProgress(List<Block> blocks, RegeneratePreviewsDialog dialogInstance)
    {
        int successCount = 0;
        int errorCount = 0;
        int completedCount = 0;

        try
        {
            dialogInstance?.SetGeneratingState(true);

            // Use parallel processing for better performance while maintaining progress tracking
            await using var progressTimer = new Timer(state =>
            {
                var dialog = state as RegeneratePreviewsDialog;
                if (dialog is not null)
                {
                    // Update progress based on completed count
                    var currentCompleted = Volatile.Read(ref completedCount);
                    var currentSuccess = Volatile.Read(ref successCount);
                    var currentErrors = Volatile.Read(ref errorCount);

                    dialog.UpdateProgress(currentCompleted, blocks.Count,
                        currentCompleted < blocks.Count ? "Processing..." : "Complete",
                        currentSuccess, currentErrors);
                }
            }, dialogInstance, TimeSpan.Zero, TimeSpan.FromMilliseconds(500)); // Update every 500ms

            int maxDegreeOfParallelism = PlatformSettingsOptions.Value.IniaAi.LlmMaxDegreeOfParallelism ?? Environment.ProcessorCount;

            var parallelOptions = new ParallelOptions
            {
                MaxDegreeOfParallelism = Math.Min(maxDegreeOfParallelism, 3) // Limit concurrent requests
            };

            await Parallel.ForEachAsync(blocks, parallelOptions, async (block, cancellationToken) =>
            {
                if (block.Properties is not AiQueryProperties props)
                {
                    Logger.LogWarning("Skipping preview generation for block {BlockId} of type {BlockType} due to incompatible properties",
                        block.Id, block.Type);
                    Interlocked.Increment(ref errorCount);
                    return;
                }

                var success = await TryGeneratePreviewWithRetry(props, block.ReplacementTag, maxRetries: 2);
                if (success)
                {
                    Interlocked.Increment(ref successCount);
                }
                else
                {
                    // Apply graceful degradation
                    props.UserPromptTemplatePreview = CreateFallbackPreview(props);
                    Interlocked.Increment(ref errorCount);
                }

                Interlocked.Increment(ref completedCount);
            });

            // Final progress update
            dialogInstance?.UpdateProgress(blocks.Count, blocks.Count, "Complete", successCount, errorCount);

            // Show results for a moment before closing
            await Task.Delay(1000);

            // Show results notification
            if (successCount > 0)
            {
                AppState.Notify($"Generated {successCount} prompt previews successfully", Severity.Success);
            }

            if (errorCount > 0)
            {
                AppState.Notify($"Failed to generate {errorCount} prompt previews (used fallback)", Severity.Warning);
            }

            // Return true if at least some previews were generated (including fallbacks)
            return successCount + errorCount == blocks.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical error during preview generation");
            AppState.Notify("Critical error during preview generation", Severity.Error);

            dialogInstance?.SetGeneratingState(false);
            return false;
        }
        finally
        {
            dialogInstance?.SetGeneratingState(false);
        }
    }

