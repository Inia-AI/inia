    private async Task ReloadAfterBundleApplyAsync(ImportWorkflowTemplateApplyResult applied)
    {
        bool editorStale = false;
        if (applied.Template.VersionId is { } newHeadVersionId)
        {
            ErrorOr<WorkflowVersionContentDto> content = await ServiceScopeFactory.SendScopedAsync(
                new GetWorkflowVersionQuery(_user.OrganizationId, newHeadVersionId));
            if (!content.IsError && Workflow.FromJson(content.Value.WorkflowJson) is { } freshHead)
            {
                _isUploadedFromFile = false;
                _restoredVersion = null;
                await ApplyLoadedWorkflowAsync(freshHead);
                _baseVersionId = newHeadVersionId;
            }
            else
            {
                editorStale = true;
            }
        }

        await RefreshVersionInfoAsync();
        if (editorStale)
        {
            AppState.Notify(
                "Bundle imported on the server, but the editor could not reload the new version — reopen the workflow to see it.",
                Severity.Warning);
            return;
        }

        int created = applied.ComponentOutcomes.Count(o => o.Action == SharedComponentTransferComponentAction.Created);
        int appended = applied.ComponentOutcomes.Count(o => o.Action == SharedComponentTransferComponentAction.Appended);
        int deduped = applied.ComponentOutcomes.Count(o => o.Action == SharedComponentTransferComponentAction.Deduped);
        int kept = applied.ComponentOutcomes.Count(o => o.Action == SharedComponentTransferComponentAction.Kept);
        string templateLine = applied.Template.WasDeduped ? "template already in sync" : "template updated";
        AppState.Notify(
            $"Bundle imported — components: {created} created, {appended} updated, {deduped} already in sync, "
            + $"{kept} kept; {templateLine}.",
            Severity.Success);
    }

