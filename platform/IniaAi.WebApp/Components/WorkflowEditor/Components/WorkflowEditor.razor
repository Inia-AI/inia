            {
                Title = "Unsaved changes",
                Message = "A bundle always exports the last saved version, and the editor has unsaved changes.",
                YesText = "Save, then export",
                NoText = "Export last saved",
                CancelText = "Cancel",
            };
            bool? choice = await DialogService.ShowMessageBoxAsync(dirtyOptions, _smallDialogOptions);
            if (choice is null)
