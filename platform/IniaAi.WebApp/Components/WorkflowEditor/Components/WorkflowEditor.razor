    /// <summary>
    /// A block run here cites pages the run loaded, not pages an uploaded run carried, so their
    /// text joins the download the way the executed-run download adds it from the database.
    /// </summary>
    private void CarryEditorRunPages(Workflow workflow)
    {
        HashSet<string> carried = [.. workflow.CitationTracePages.Select(page => page.Id)];
        HashSet<string> cited = [.. workflow.CitationTracePageIds().Where(id => !carried.Contains(id))];
        foreach (DocumentPage page in EditorContext.WorkflowHandler.AllPages.Where(page => cited.Contains(page.Id)))
        {
            if (page.Text is string text)
            {
                workflow.CitationTracePages.Add(new CitationTracePage(page.Id, text));
            }
        }
    }

