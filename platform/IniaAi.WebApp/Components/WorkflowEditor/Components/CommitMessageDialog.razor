@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2">Add details about what changed.</MudText>
        <MudTextField @bind-Value="Message"
                      Label="Details (optional)"
                      Placeholder="Describe your change"
                      Variant="Variant.Outlined"
                      Lines="4"
                      FullWidth="true"
                      Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="() => MudDialog.Close(DialogResult.Ok(Message ?? string.Empty))" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? InitialMessage { get; set; }

    private string? Message { get; set; }

    protected override void OnInitialized()
    {
        Message = InitialMessage ?? string.Empty;
    }
}
