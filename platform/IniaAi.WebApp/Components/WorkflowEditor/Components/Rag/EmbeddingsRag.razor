@using IniaAi.Domain.Core.Interfaces
@using IniaAi.Domain.Entities.Workflows
@using IniaAi.Domain.Entities.Workflows.Enums
@using IniaAi.Domain.UserData.Interfaces

<MudStack Spacing="3">
    <MudGrid Spacing="2" Class="editor-twin-grid">
        <MudItem xs="12" md="6">
            <MudTextField Label="Start Index Template"
                          Variant="Variant.Outlined"
                          Class="editor-mono-field"
                          @bind-Value="RagSettings.StartIndexInput" />
        </MudItem>
        @if (RagSettings.ExecutionState is not null)
        {
            <MudItem xs="12" md="6">
                <MudTextField Label="Start Index After Execution"
                              Variant="Variant.Outlined"
                              Class="editor-mono-field editor-resolved"
                              ReadOnly="true"
                              Value="@RagSettings.ExecutionState.StartIndexInput" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="2" Class="editor-twin-grid">
        <MudItem xs="12" md="6">
            <MudTextField Label="End Index Template"
                          Variant="Variant.Outlined"
                          Class="editor-mono-field"
                          @bind-Value="RagSettings.EndIndexInput" />
        </MudItem>
        @if (RagSettings.ExecutionState is not null)
        {
            <MudItem xs="12" md="6">
                <MudTextField Label="End Index After Execution"
                              Variant="Variant.Outlined"
                              Class="editor-mono-field editor-resolved"
                              ReadOnly="true"
                              Value="@RagSettings.ExecutionState.EndIndexInput" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="2" Class="editor-twin-grid">
        <MudItem xs="12" md="6">
            <MudTextField Label="Number Of Pages To Use Template"
                          Variant="Variant.Outlined"
                          Class="editor-mono-field"
                          @bind-Value="RagSettings.NumberOfPagesInput" />
        </MudItem>
        @if (RagSettings.ExecutionState is not null)
        {
            <MudItem xs="12" md="6">
                <MudTextField Label="Number Of Pages To Use After Execution"
                              Variant="Variant.Outlined"
                              Class="editor-mono-field editor-resolved"
                              ReadOnly="true"
                              Value="@RagSettings.ExecutionState.NumberOfPagesInput" />
            </MudItem>
        }
    </MudGrid>

    <MudText Typo="Typo.body1">
        Smart filter expressions:
    </MudText>

    <MudText Typo="Typo.caption">
        The contents of the files that are used to get the InputContext for
        the blocks in this workflow are filtered by these expressions.
        The filtering is done using semantic search (embeddings).
    </MudText>

    @for (int i = 0; i < RagSettings.SmartFilterExpressions.Count(); i++)
    {
        var index = i;

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudGrid Spacing="2" Class="flex-grow-1 editor-twin-grid">
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Smart Filter Expression Template"
                                  Class="editor-mono-field"
                                  @bind-Value="RagSettings.SmartFilterExpressions[index]" />
                </MudItem>

                @if (RagSettings.ExecutionState is not null
                    && RagSettings.ExecutionState.SmartFilterExpressions.Count > index)
                {
                    <MudItem xs="12" md="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="Smart Filter Expression After Execution"
                                      Class="editor-mono-field editor-resolved"
                                      ReadOnly="true"
                                      Value="@RagSettings.ExecutionState.SmartFilterExpressions[index]" />
                    </MudItem>
                }
            </MudGrid>

            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Delete"
                       Color="Color.Error"
                       Class="editor-soft-button"
                       OnClick="() => RagSettings.SmartFilterExpressions.RemoveAt(index)">
                Remove expression
            </MudButton>
        </MudStack>
    }

    <div>
        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                   Variant="Variant.Text"
                   Class="editor-soft-button"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="() => RagSettings.SmartFilterExpressions.Add(string.Empty)">
            Add Expression
        </MudButton>
    </div>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public RagSettings RagSettings { get; set; } = default!;
}
