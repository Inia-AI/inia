@using IniaAi.Domain.Entities.Workflows

<MudStack Spacing="3">
    <MudGrid Spacing="2" Class="editor-twin-grid">
        <MudItem xs="12" md="6">
            <MudTextField Label="Table Of Contents Model Template"
                          Variant="Variant.Outlined"
                          Class="editor-mono-field"
                          @bind-Value="RagSettings.TableOfContentsInput"
                          Sizing="InputSizing.Auto"
                          Lines="5"
                          MaxLines="20" />
        </MudItem>

        @if (RagSettings.ExecutionState is not null)
        {
            <MudItem xs="12" md="6">
                <MudTextField Label="Table Of Contents After Execution"
                              Variant="Variant.Outlined"
                              Class="editor-mono-field editor-resolved"
                              ReadOnly="true"
                              Value="@RagSettings.ExecutionState.TableOfContentsInput"
                              Sizing="InputSizing.Auto"
                              Lines="5"
                              MaxLines="20" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="2" Class="editor-twin-grid">
        <MudItem xs="12" md="6">
            <MudTextField Label="Query For Table Of Contents Template"
                          Variant="Variant.Outlined"
                          Class="editor-mono-field"
                          @bind-Value="RagSettings.TopicsQuery" />
        </MudItem>

        @if (RagSettings.ExecutionState is not null)
        {
            <MudItem xs="12" md="6">
                <MudTextField Label="Query For Table Of Contents After Execution"
                              Variant="Variant.Outlined"
                              Class="editor-mono-field editor-resolved"
                              ReadOnly="true"
                              Value="@RagSettings.ExecutionState.TopicsQuery" />
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public RagSettings RagSettings { get; set; } = default!;
}
