            Severity.Success);
    }

    public async Task ToggleCitationsForAllSections()
    {
        bool newCitationsSetting = !EditorContext.Workflow.GetAllBlocks()
            .Any(b => b.Properties is AiQueryProperties props && props.ShouldGetCitationsFromModel == true);

        Logger.LogInformation(
            "Toggling citations setting for all sections in workflow type {WorkflowType}, new setting: {NewSetting}",
            GetWorkflowTypeDisplayName(),
            newCitationsSetting);

        foreach (Section section in EditorContext.Workflow.Sections)
        {
            SurfaceState.ApplySectionCitations(section, newCitationsSetting);
        }

        AppState.Notify(
            $"Citations {(newCitationsSetting ? "enabled" : "disabled")} for all sections",
            Severity.Success);
    }
}
