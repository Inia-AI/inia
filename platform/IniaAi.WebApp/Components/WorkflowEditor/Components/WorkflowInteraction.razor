    /// <summary>
    /// Shows the blocks for the workflow item with the specified <paramref name="workflowId"/>.
    /// </summary>
    /// <remarks>
    /// Side effects:
    /// - Sets <c>_isShowingBlocks</c> to <c>true</c>.
    /// - Sets <c>_activeWorkflowItem</c> to the workflow child matching <paramref name="workflowId"/>.
    /// - Updates workflow state and scrolls to the active workflow item in the UI.
    /// </remarks>
    /// <param name="workflowId">The ID of the workflow whose blocks should be displayed.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    /// <remarks>
    /// Usage context:
    /// - Intended to be invoked externally via a parent component using <c>@ref</c>.
    /// </remarks>
    public async Task ShowBlocks(string workflowId)
    {
        _isShowingBlocks = true;
        _isGraphTabActive = false;
        _activeWorkflowItem = EditorContext.Workflow.Sections.FirstOrDefault(s => s.Id == workflowId);

        await UpdateWorkflowStateAsync();

        // Wait for the component to render, then scroll to it. Target the non-sticky
        // shell anchor rather than the section card: the card is position:sticky, so
        // scrolling to it is a no-op when it is already pinned at the top.
        await Task.Delay(200);

        if (_activeWorkflowItem is not null)
        {
            await JsRuntime.InvokeVoidAsync(SCROLL_TO_ELEMENT_JS, $"sectiontop_{_activeWorkflowItem.Id}");
        }
    }

    private async Task GoBack()
    {
        await HideBlocks(null);
    }

    private async Task HideBlocks(string? idToScrollTo = null)
    {
        _isShowingBlocks = false;

        await UpdateWorkflowStateAsync();

        await Task.Delay(100);
        await JsRuntime.InvokeVoidAsync(SCROLL_TO_ELEMENT_JS, idToScrollTo ?? _activeWorkflowItem?.Id);
    }

