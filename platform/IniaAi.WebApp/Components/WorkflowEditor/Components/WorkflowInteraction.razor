    private string ResolveTargetOrganizationId(Workflow targetWorkflow)
    {
        return string.IsNullOrWhiteSpace(targetWorkflow.OrganizationId)
            ? _user.OrganizationId
            : targetWorkflow.OrganizationId;
    }

    private async Task<string?> GetTargetHeadVersionIdAsync(
        IServiceScope scope,
        Workflow targetWorkflow,
        string targetWorkflowTypeId)
    {
        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
        ErrorOr<WorkflowHeadVersionResult> head = await sender.Send(
            new GetWorkflowHeadVersionQuery(
                ResolveTargetOrganizationId(targetWorkflow),
                targetWorkflowTypeId));

        if (head.IsError)
        {
            Logger.LogWarning(
                "Could not read the head version of target Core workflow {WorkflowTypeId} before copy: {Error}",
                targetWorkflowTypeId,
                head.FirstError.Description);
            return null;
        }

        return head.Value.VersionId;
    }

    private async Task<ErrorOr<SaveWorkflowResult>> SaveTargetWorkflowAsync(
        IServiceScope scope,
        Workflow targetWorkflow,
        string targetWorkflowTypeId,
        string? targetHeadVersionId)
    {
        string organizationId = ResolveTargetOrganizationId(targetWorkflow);

        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
        ErrorOr<SaveWorkflowResult> saveResult = await sender.Send(new SaveWorkflowCommand(
            organizationId,
            _user.Id,
            targetWorkflowTypeId,
            targetWorkflow,
            targetHeadVersionId,
            EnforceOptimisticConcurrency: true));

        if (saveResult.IsError)
        {
            Logger.LogError(
                "Versioned save of target Core workflow {WorkflowTypeId} failed after copy: {Error}",
                targetWorkflowTypeId,
                saveResult.FirstError.Description);

            return saveResult;
        }

        foreach (string saveWarning in saveResult.Value.Warnings ?? [])
        {
            AppState.Notify(saveWarning, Severity.Warning);
        }

        // Mirror the saved target template to the GitHub workflow repository, matching the
        // editor's own save path. Skip a deduped save (unchanged content, nothing to commit).
        if (!saveResult.Value.WasDeduped)
        {
            await TryMirrorTargetWorkflowToGitHubAsync(targetWorkflow, targetWorkflowTypeId);
        }

        return saveResult;
    }

    private async Task TryMirrorTargetWorkflowToGitHubAsync(Workflow targetWorkflow, string targetWorkflowTypeId)
    {
        // Best-effort: the save is already persisted, so a mirror failure must not surface as a
        // copy failure. Mirrors the error handling of the editor's own GitHub auto-commit.
        try
        {
            GitHubCommitResult result = await GitHubWorkflowVersioningService.CommitWorkflowAsync(
                workflowTypeId: targetWorkflowTypeId,
                area: string.Empty,
                function: string.Empty,
                content: targetWorkflow.ToExportJson(),
                commitMessage: $"Save workflow {targetWorkflowTypeId}",
                authorName: _user.UserName ?? "Unknown",
                authorEmail: _user.Email ?? "unknown@example.com");

            // An empty Sha means the mirror was a no-op (disabled), so don't claim it committed.
            if (!string.IsNullOrEmpty(result.Sha))
            {
                Logger.LogInformation(
                    "Mirrored target workflow {WorkflowTypeId} to GitHub after copy ({Sha})",
                    targetWorkflowTypeId,
                    result.Sha);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Failed to mirror target workflow {WorkflowTypeId} to GitHub after copy; the save succeeded",
                targetWorkflowTypeId);

            AppState.Notify($"GitHub mirror failed: {ex.Message}", Severity.Warning);
        }
    }

    private async Task CopySectionAsText(int sectionOrder)
    {
        var section = EditorContext.Workflow.Sections
            .FirstOrDefault(s => s.Order == sectionOrder);

        if (section is null)
