    private async Task CopySectionToCoreWorkflow(int index)
    {
        Logger.LogInformation(
            "Copying section at index {Index} to a Core workflow for workflow type {WorkflowType}",
            index,
            GetWorkflowTypeDisplayName());

        Section? section = EditorContext
            .Workflow
            .Sections
            .FirstOrDefault(s => s.Order == index);

        if (section is null)
        {
            Logger.LogWarning(
                "Section not found at index {Index} for workflow type {WorkflowType}",
                index,
                GetWorkflowTypeDisplayName());

            AppState.Notify(
                "Failed to copy section: Section not found",
                Severity.Error);
            return;
        }

        try
        {
            DialogParameters<CopySectionToCoreDialog> parameters = [];
            var dialog = await DialogService.ShowAsync<CopySectionToCoreDialog>("Copy Section to Core Workflow", parameters);
            var result = await dialog.Result;

            if (result is null || result.Canceled)
            {
                Logger.LogWarning(
                    "Copy section to Core dialog was canceled for workflow type {WorkflowType}",
                    GetWorkflowTypeDisplayName());
                return;
            }

            if (result.Data is null
                || result.Data is not (WorkflowType targetWorkflowType, int targetIndex))
            {
                Logger.LogWarning(
                    "Invalid result from copy section to Core dialog for workflow type {WorkflowType}",
                    GetWorkflowTypeDisplayName());
                return;
            }

            using IServiceScope scope = ServiceScopeFactory.CreateScope();
            ICoreUnitOfWork coreUnitOfWork = scope.ServiceProvider.GetRequiredService<ICoreUnitOfWork>();

            Workflow? coreWorkflow = await coreUnitOfWork
                .Workflows
                .GetByTypeIdAsNoTrackingAsync(targetWorkflowType.Id);

            if (coreWorkflow is null)
            {
                Logger.LogWarning(
                    "Target Core workflow not found for workflow type {TargetWorkflowTypeId} when copying from workflow type {WorkflowType}",
                    targetWorkflowType.Id,
                    GetWorkflowTypeDisplayName());

                AppState.Notify(
                    $"Failed to copy section: Target Core workflow not found for workflow type {targetWorkflowType.Name}",
                    Severity.Error);
                return;
            }

            string? targetHeadVersionId = await GetTargetHeadVersionIdAsync(scope, coreWorkflow, targetWorkflowType.Id);

            Section clonedSection = section.CloneToWorkflow(coreWorkflow, targetIndex);
            int carriedDefinitions = CarrySignatureDefinitionsToTarget(clonedSection.Blocks, coreWorkflow);

            ErrorOr<SaveWorkflowResult> saveResult = await SaveTargetWorkflowAsync(scope, coreWorkflow, targetWorkflowType.Id, targetHeadVersionId);
            if (saveResult.IsError)
            {
                AppState.Notify(
                    SaveWorkflowCommandHandler.IsVersionConflict(saveResult.FirstError)
                        ? TARGET_CHANGED_MESSAGE
                        : $"Failed to copy section: {saveResult.FirstError.Description}",
                    Severity.Error);
                return;
            }

            NotifyCarriedSignatureDefinitions(carriedDefinitions, targetWorkflowType.Name);

            Logger.LogInformation(
                "Section '{SectionTitle}' copied from workflow type {WorkflowType} to Core workflow {TargetWorkflowType} at index {TargetIndex}",
                section.Title,
                GetWorkflowTypeDisplayName(),
                targetWorkflowType.Name,
                targetIndex);

            AppState.Notify(
                $"Section '{section.Title}' successfully copied to Core workflow '{targetWorkflowType.Name}'",
                Severity.Success);
        }
        catch (Exception e)
        {
            Logger.LogError(
                e,
                "Failed to copy section at index {Index} from workflow type {WorkflowType} to Core workflow",
                index,
                GetWorkflowTypeDisplayName());

            AppState.Notify(
                $"Failed to copy section to Core workflow: {e.Message}",
                Severity.Error);
        }
    }

    private async Task CopyBlockToCoreWorkflow(Block block)
    {
        Logger.LogInformation("Copying block at index {Index} to a Core workflow", block.Order);

        if (block.Section is null)
        {
            Logger.LogWarning("Block has no section");

            AppState.Notify(
                "Failed to copy block: Block has no section",
                Severity.Error);
            return;
        }

        try
        {
            DialogParameters<CopyBlockToCoreDialog> parameters = [];
            var dialog = await DialogService.ShowAsync<CopyBlockToCoreDialog>("Copy Block to Core Workflow", parameters);
            var result = await dialog.Result;

            if (result is null || result.Canceled)
            {
                Logger.LogWarning("Copy block to Core dialog was canceled.");
                return;
            }

            if (result.Data is null
                || result.Data is not (WorkflowType targetWorkflowType, Section targetSection, int targetIndex))
            {
                Logger.LogWarning("Invalid result from dialog.");
                return;
            }

            using IServiceScope scope = ServiceScopeFactory.CreateScope();
            ICoreUnitOfWork coreUnitOfWork = scope.ServiceProvider.GetRequiredService<ICoreUnitOfWork>();

            Workflow? coreWorkflow = await coreUnitOfWork
                .Workflows
                .GetByTypeIdAsNoTrackingAsync(targetWorkflowType.Id);

            if (coreWorkflow is null)
            {
                Logger.LogWarning("Target Core workflow not found for workflow type {WorkflowTypeId}", targetWorkflowType.Id);

                AppState.Notify(
                    $"Failed to copy block: Target Core workflow not found for workflow type {targetWorkflowType.Name}",
                    Severity.Error);
                return;
            }

            // Find the target section in the core workflow. Filter separators so a
            // separator can't be picked up as the target by Order.
            Section? coreTargetSection = coreWorkflow.Sections
                .Where(s => !s.IsSeparator)
                .FirstOrDefault(s => s.Order == targetSection.Order);

            if (coreTargetSection is null)
            {
                Logger.LogWarning("Target section not found in Core workflow");

                AppState.Notify(
                    "Failed to copy block: Target section not found in Core workflow",
                    Severity.Error);
                return;
            }

            string? targetHeadVersionId = await GetTargetHeadVersionIdAsync(scope, coreWorkflow, targetWorkflowType.Id);

            Block copiedBlock = block.CopyToSection(coreTargetSection, targetIndex);
            coreTargetSection.NormalizeBlockOrdering();
            int carriedDefinitions = CarrySignatureDefinitionsToTarget([copiedBlock], coreWorkflow);

            ErrorOr<SaveWorkflowResult> saveResult = await SaveTargetWorkflowAsync(scope, coreWorkflow, targetWorkflowType.Id, targetHeadVersionId);
            if (saveResult.IsError)
            {
                AppState.Notify(
                    SaveWorkflowCommandHandler.IsVersionConflict(saveResult.FirstError)
                        ? TARGET_CHANGED_MESSAGE
                        : $"Failed to copy block: {saveResult.FirstError.Description}",
                    Severity.Error);
                return;
            }

            NotifyCarriedSignatureDefinitions(carriedDefinitions, targetWorkflowType.Name);

            Logger.LogInformation(
                "Block '{BlockName}' copied to Core workflow {WorkflowType}, section {SectionTitle} at index {Index}",
                block.Name,
                targetWorkflowType.Name,
                coreTargetSection.Title,
                targetIndex);

            AppState.Notify(
                $"Block '{block.Name}' successfully copied to Core workflow '{targetWorkflowType.Name}', section '{coreTargetSection.Title}'",
                Severity.Success);
        }
        catch (Exception e)
        {
            Logger.LogError(
                e,
                "Failed to copy block to Core workflow");

            AppState.Notify(
                $"Failed to copy block to Core workflow: {e.Message}",
                Severity.Error);
        }
    }

