<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2">
            '@BlockName' comes from Library section '@SectionComponentName'. Removing it here hides
            it in this workflow only — the section stays linked, other workflows keep the entry, and
            you can restore it later from Library sync.
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">
            Hide here
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string BlockName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SectionComponentName { get; set; } = string.Empty;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
