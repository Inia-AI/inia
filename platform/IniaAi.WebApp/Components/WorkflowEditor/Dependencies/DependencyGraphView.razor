@implements IAsyncDisposable

@using IniaAi.Common.Constants
@using System.Text.Json
@using Block = IniaAi.Domain.Entities.Workflows.Blocks.Block
@using IniaAi.Core.Workflows.Dependencies
@using IniaAi.WebApp.Components.WorkflowEditor.State

@inject IJSRuntime JsRuntime
@inject ILogger<DependencyGraphView> Logger

@* The dependency graph itself, shared by the editor's Graph tab and the dependency chain slide-over. *@
<div class="@($"dep-view {(IsSlideOver ? "dep-view--slideover" : "dep-view--tab")}")" @ref="_host">
    <header class="dep-view__header">
        @if (IsSlideOver)
        {
            <MudText Typo="Typo.subtitle2" Class="dep-view__title">Dependency chain</MudText>
        }
        else
        {
            <MudButtonGroup Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false" aria-label="Graph view">
                <MudButton Size="Size.Small"
                           Color="Color.Primary"
                           Variant="@(IsChain ? Variant.Filled : Variant.Outlined)"
                           aria-pressed="@(IsChain ? "true" : "false")"
                           Disabled="@(State.FocusBlockId is null)"
                           title="@(State.FocusBlockId is null ? "Click a block on the map to see its chain" : null)"
                           OnClick="ShowChainAsync">
                    Chain
                </MudButton>
                <MudButton Size="Size.Small"
                           Color="Color.Primary"
                           Variant="@(IsChain ? Variant.Outlined : Variant.Filled)"
                           aria-pressed="@(IsChain ? "false" : "true")"
                           OnClick="ShowMapAsync">
                    Map
                </MudButton>
            </MudButtonGroup>
        }

        <MudSpacer />

        @if (Issues.Count > 0)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Dense="true"
                     Label="@(Issues.Count == 1 ? "1 issue" : $"{Issues.Count} issues")"
                     StartIcon="@Icons.Material.Outlined.ReportProblem"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     Color="Color.Warning">
                <ChildContent>
                    @foreach (DependencyIssue issue in Issues)
                    {
                        <MudMenuItem OnClick="@(() => FocusIssueAsync(issue))">
                            @IssueText(issue)
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }

        <MudIconButton Icon="@Icons.Material.Outlined.FitScreen"
                       Size="Size.Small"
                       aria-label="Fit the graph to the view"
                       title="Fit"
                       OnClick="FitAsync" />

        @if (SeeOnFullGraph.HasDelegate && State.FocusBlockId is not null)
        {
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Outlined.OpenInFull"
                       OnClick="SeeOnFullGraphAsync">
                See on the full graph
            </MudButton>
        }

        @if (OnClose.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           aria-label="Close the dependency chain"
                           title="Close (Esc)"
                           OnClick="OnClose" />
        }
    </header>

    <div class="dep-view__toolbar">
        <MudChip T="string"
                 Size="Size.Small"
                 Color="Color.Secondary"
                 Variant="@(State.ShowInputs ? Variant.Filled : Variant.Outlined)"
                 aria-pressed="@(State.ShowInputs ? "true" : "false")"
                 Icon="@Icons.Material.Outlined.Input"
                 OnClick="ToggleAllInputsAsync">
            Inputs
        </MudChip>
        <MudChip T="string"
                 Size="Size.Small"
                 Color="Color.Warning"
                 Variant="@(State.ShowGates ? Variant.Filled : Variant.Outlined)"
                 aria-pressed="@(State.ShowGates ? "true" : "false")"
                 Icon="@Icons.Material.Outlined.Rule"
                 OnClick="ToggleAllGatesAsync">
            Gates
        </MudChip>
        @if (SurfaceState?.AgentPreview is not null)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Color="Color.Primary"
                     Variant="@(_showProposal ? Variant.Filled : Variant.Outlined)"
                     aria-pressed="@(_showProposal ? "true" : "false")"
                     Icon="@Icons.Material.Outlined.AutoAwesome"
                     data-testid="dep-agent-proposal"
                     title="Show the workflow with the changes the agent proposes and nobody has decided yet"
                     OnClick="ToggleProposalAsync">
                Agent's proposal
            </MudChip>
        }
    </div>

    <div class="dep-view__legend" aria-label="Legend">
        <span><i class="dep-legend dep-legend--data"></i>reads output</span>
        <span><i class="dep-legend dep-legend--document"></i>documents</span>
        <span><i class="dep-legend dep-legend--counterparty"></i>@CounterpartyTerms.SINGULAR_LOWER</span>
        <span><i class="dep-legend dep-legend--gate"></i>section gate</span>
        @if (Preview is not null)
        {
            <span><i class="dep-legend dep-legend--agent-added"></i>proposed new</span>
            <span><i class="dep-legend dep-legend--agent-changed"></i>proposed change</span>
        }
    </div>

    @if (IsChain && State.Trail.Count > 1)
    {
        <nav class="dep-view__trail" aria-label="Blocks you looked at">
            @for (int i = 0; i < State.Trail.Count; i++)
            {
                string id = State.Trail[i];
                bool current = i == State.Trail.Count - 1;
                @if (i > 0)
                {
                    <span class="dep-view__trail-sep" aria-hidden="true">›</span>
                }
                <button type="button"
                        class="@($"dep-view__crumb{(current ? " dep-view__crumb--current" : "")}")"
                        aria-current="@(current ? "true" : null)"
                        @onclick="@(() => FocusAsync(id))">
                    @CrumbLabel(id)
                </button>
            }
        </nav>
    }

    @if (_buildError is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mx-2 mt-2">@_buildError</MudAlert>
    }

    <div class="dep-view__canvas" @ref="_canvas"></div>
</div>

@code {
    private const int REFRESH_DELAY_MS = 350;
    private const string MODULE_PATH = "js/dependency-graph.js";
    private const string WORKER_PATH = "js/dependency-graph.worker.js";
    private const string ELK_PATH = "lib/elkjs/elk.bundled.js";

    private const string ACTION_FOCUS = "focus";
    private const string ACTION_REVEAL = "reveal";
    private const string ACTION_OPEN = "open";
    private const string ACTION_STUB = "stub";
    private const string ACTION_INPUTS = "inputs";
    private const string ACTION_GATES = "gates";
    private const string ACTION_SECTION = "section";
    private const string ACTION_CLOSE = "close";

    private const string JS_CREATE = "create";
    private const string JS_RENDER = "render";
    private const string JS_FIT = "fit";
    private const string JS_DISPOSE = "dispose";

    private ElementReference _host;
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<DependencyGraphView>? _self;
    private CancellationTokenSource? _refreshDelay;
    private WorkflowDependencyMap? _map;
    private IniaAi.Domain.Entities.Workflows.Workflow? _mappedWorkflow;
    private IniaAi.WebApp.Components.WorkflowEditor.Agent.EditorAgentPreview? _mappedPreview;
    private bool _showProposal = true;
    private bool _mapStale = true;
    private string? _buildError;
    private string? _renderedScene;
    private bool _disposed;

    [CascadingParameter(Name = "EditorContext")]
    public WorkflowEditorContext EditorContext { get; set; } = default!;

    [CascadingParameter]
    public EditorSurfaceState SurfaceState { get; set; } = default!;

    /// <summary>What the reader asked to see. The host owns it, so it outlives this view.</summary>
    [Parameter, EditorRequired]
    public DependencyViewState State { get; set; } = default!;

    /// <summary>
    /// In the slide-over the chain follows the editor beside it: a block clicked in the chain is
    /// shown in the editor, and a block the author clicks into in the editor becomes the focus.
    /// </summary>
    [Parameter]
    public bool IsSlideOver { get; set; }

    /// <summary>Shows a block in the editor and highlights it.</summary>
    [Parameter]
    public Func<Block, Task>? OpenInEditor { get; set; }

    /// <summary>Set by the slide-over: opens the Graph tab on the focused block.</summary>
    [Parameter]
    public EventCallback<string> SeeOnFullGraph { get; set; }

    /// <summary>Set by the slide-over: closes it.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsChain => State.Mode == DependencyViewModes.CHAIN;

    private IReadOnlyList<DependencyIssue> Issues => _map?.Issues ?? [];

    protected override void OnInitialized()
    {
        SurfaceState.SectionChanged += OnSectionChanged;
        SurfaceState.BlockChanged += OnBlockChanged;
    }

    /// <summary>
    /// The host re-renders often, so only a replaced workflow (an upload or a restored version) or a
    /// block another surface asked the map to show draws here; edits wait for the debounced refresh.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        bool replaced = _mappedWorkflow is not null
            && (!ReferenceEquals(_mappedWorkflow, EditorContext.Workflow) || !ReferenceEquals(_mappedPreview, Preview));
        if (replaced)
        {
            _mapStale = true;
        }

        if (_controller is not null && (replaced || State.PendingMapFocusId is not null))
        {
            await DrawAsync(skipUnchanged: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AttachAsync();
        }
    }

    /// <summary>Marks the map stale after a change the view was not told about, and redraws it shortly.</summary>
    public void ScheduleRefresh()
    {
        _mapStale = true;
        if (_disposed)
        {
            return;
        }

        _refreshDelay?.Cancel();
        _refreshDelay?.Dispose();
        _refreshDelay = new CancellationTokenSource();
        _ = RefreshAfterDelayAsync(_refreshDelay.Token);
    }

    /// <summary>Rebuilds the map now and draws what <see cref="State"/> asks for.</summary>
    public async Task RefreshAsync()
    {
        _mapStale = true;
        await DrawAsync();
        StateHasChanged();
    }

    [JSInvokable("OnGraphAction")]
    public async Task OnGraphActionAsync(string action, string id)
    {
        switch (action)
        {
            case ACTION_FOCUS:
                await FocusAsync(id);
                return;
            case ACTION_REVEAL:
            case ACTION_OPEN:
                await OpenInEditorAsync(id);
                return;
            case ACTION_CLOSE:
                await OnClose.InvokeAsync();
                return;
            case ACTION_STUB:
                _ = State.ExpandStub(id);
                break;
            case ACTION_INPUTS:
                State.ToggleInputs(id);
                break;
            case ACTION_GATES:
                State.ToggleGates(id);
                break;
            case ACTION_SECTION:
                State.ToggleSection(id);
                break;
            default:
                return;
        }

        await DrawAsync();
        StateHasChanged();
    }

    [JSInvokable("OnEditorBlockSelected")]
    public async Task OnEditorBlockSelectedAsync(string blockId)
    {
        if (!_mapStale && _map?.FindBlock(blockId) is null)
        {
            return;
        }

        if (State.Focus(blockId))
        {
            await DrawAsync();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnEditorEdited()
    {
        ScheduleRefresh();
    }

    /// <summary>
    /// Starts the graph module. The component can be disposed during any await here (a fast
    /// navigation away or a closed slide-over), so each step checks and releases what it has created so far.
    /// </summary>
    private async Task AttachAsync()
    {
        try
        {
            _self = DotNetObjectReference.Create(this);
            IJSObjectReference module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", $"./{Assets[MODULE_PATH]}");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }

            IJSObjectReference controller = await module.InvokeAsync<IJSObjectReference>(
                JS_CREATE,
                _canvas,
                _host,
                _self,
                new
                {
                    workerUrl = Assets[WORKER_PATH].ToString(),
                    elkUrl = Assets[ELK_PATH].ToString(),
                    slideOver = IsSlideOver,
                });
            if (_disposed)
            {
                await controller.InvokeVoidAsync(JS_DISPOSE);
                await controller.DisposeAsync();
                await module.DisposeAsync();
                return;
            }

            _module = module;
            _controller = controller;
            await DrawAsync();
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The dependency graph could not start its module");
            _buildError = "The dependency graph could not start in this browser.";
            StateHasChanged();
        }
    }

    private async Task RefreshAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(REFRESH_DELAY_MS, cancellationToken);
            await InvokeAsync(async () =>
            {
                await DrawAsync(skipUnchanged: true);
                StateHasChanged();
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <param name="skipUnchanged">
    /// Set for a redraw after a possible edit: leaving a field with nothing changed rebuilds the
    /// map, but an unchanged scene is not laid out and drawn again.
    /// </param>
    private async Task DrawAsync(bool skipUnchanged = false)
    {
        if (_controller is null || _disposed)
        {
            return;
        }

        if (_mapStale || _map is null)
        {
            RebuildMap();
        }

        if (_map is null)
        {
            return;
        }

        WorkflowDependencyMap map = _map;
        _ = State.ApplyPendingMapFocus(id => map.FindBlock(id) is { } block ? DependencySceneBuilder.SectionKey(block) : null);

        DependencyScene scene = WithAgentMarks(DependencySceneBuilder.Build(map, State), map);
        string rendered = JsonSerializer.Serialize(scene);
        if (skipUnchanged && rendered == _renderedScene)
        {
            return;
        }

        _renderedScene = rendered;
        await InvokeControllerAsync(JS_RENDER, scene);
    }

    /// <summary>The agent's proposal the graph draws, when there is one and it is switched on.</summary>
    private IniaAi.WebApp.Components.WorkflowEditor.Agent.EditorAgentPreview? Preview => _showProposal ? SurfaceState?.AgentPreview : null;

    private async Task ToggleProposalAsync()
    {
        _showProposal = !_showProposal;
        await RefreshAsync();
    }

    /// <summary>Marks the cards of the blocks the proposal adds or changes, and the section cards that hold them.</summary>
    private DependencyScene WithAgentMarks(DependencyScene scene, WorkflowDependencyMap map)
    {
        if (_mappedPreview is not { MarksByBlockId.Count: > 0 } preview)
        {
            return scene;
        }

        var marks = new Dictionary<string, string>(preview.MarksByBlockId, StringComparer.Ordinal);
        foreach ((string blockId, string mark) in preview.MarksByBlockId)
        {
            if (map.FindBlock(blockId) is { } block)
            {
                string sectionCard = DependencySceneBuilder.SectionCardId(DependencySceneBuilder.SectionKey(block));
                if (!marks.TryGetValue(sectionCard, out string? existing) || existing != mark)
                {
                    marks[sectionCard] = existing is null ? mark : IniaAi.WebApp.Components.WorkflowEditor.Agent.EditorAgentPreview.CHANGED;
                }
            }
        }

        return scene with
        {
            Cards = [.. scene.Cards.Select(card => marks.TryGetValue(card.Id, out string? mark) ? card with { AgentMark = mark } : card)],
        };
    }

    private void RebuildMap()
    {
        _mappedWorkflow = EditorContext.Workflow;
        _mappedPreview = Preview;
        try
        {
            _map = WorkflowDependencyMap.ForTemplate(_mappedPreview?.Workflow ?? EditorContext.Workflow);
            _buildError = null;
            State.Forget(id => _map.FindBlock(id) is not null);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not build the dependency map for workflow {WorkflowId}", EditorContext.Workflow.Id);
            _buildError = "The dependencies could not be read from the workflow as it stands. Showing the last good map.";
        }

        _mapStale = false;
    }

    private async Task ShowChainAsync()
    {
        State.ShowChain();
        await DrawAsync();
    }

    private async Task ShowMapAsync()
    {
        State.ShowMap();
        await DrawAsync();
    }

    private async Task FitAsync()
    {
        await InvokeControllerAsync(JS_FIT);
    }

    private async Task ToggleAllInputsAsync()
    {
        State.ShowInputs = !State.ShowInputs;
        await DrawAsync();
    }

    private async Task ToggleAllGatesAsync()
    {
        State.ShowGates = !State.ShowGates;
        await DrawAsync();
    }

    private async Task FocusIssueAsync(DependencyIssue issue)
    {
        if (issue.BlockIds.Count > 0)
        {
            await FocusAsync(issue.BlockIds[0]);
        }
    }

    /// <summary>Centres the chain on a block; in the slide-over the editor scrolls to it as well.</summary>
    private async Task FocusAsync(string blockId)
    {
        _ = State.Focus(blockId);
        await DrawAsync();
        StateHasChanged();
        if (IsSlideOver)
        {
            await OpenInEditorAsync(blockId);
        }
    }

    private async Task OpenInEditorAsync(string blockId)
    {
        Block? block = EditorContext.Workflow.GetAllBlocks().FirstOrDefault(candidate => candidate.Id == blockId);
        if (block is not null && OpenInEditor is not null)
        {
            await OpenInEditor(block);
        }
    }

    private async Task SeeOnFullGraphAsync()
    {
        if (State.FocusBlockId is { } blockId)
        {
            await SeeOnFullGraph.InvokeAsync(blockId);
        }
    }

    private void OnSectionChanged(IniaAi.Domain.Entities.Workflows.Section section)
    {
        _ = InvokeAsync(ScheduleRefresh);
    }

    private void OnBlockChanged(Block block)
    {
        _ = InvokeAsync(ScheduleRefresh);
    }

    private string CrumbLabel(string blockId)
    {
        return _map?.FindBlock(blockId) is { } block ? DependencySceneBuilder.BlockLabel(block) : blockId;
    }

    private string IssueText(DependencyIssue issue)
    {
        switch (issue.Kind)
        {
            case DependencyIssueKind.UnresolvedTag:
                return $"No block or input supplies {{{issue.Tag}}} (read by {string.Join(", ", issue.BlockIds.Select(CrumbLabel))})";
            case DependencyIssueKind.ReadsDocumentsBeforeProducer:
                return $"{CrumbLabel(issue.BlockIds[0])} runs before {CrumbLabel(issue.BlockIds[1])}, so it gets none of the {issue.Tag} documents that block creates";
            case DependencyIssueKind.ReadsCounterpartyBeforeWriter:
                return $"{CrumbLabel(issue.BlockIds[0])} reads {{{issue.Tag}}} before {CrumbLabel(issue.BlockIds[1])} writes it";
            default:
                return $"These blocks read each other: {string.Join(", ", issue.BlockIds.Select(CrumbLabel))}";
        }
    }

    private async Task InvokeControllerAsync(string method, params object?[] args)
    {
        if (_controller is null)
        {
            return;
        }

        try
        {
            await _controller.InvokeVoidAsync(method, args);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The dependency graph's {Method} call failed", method);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SurfaceState.SectionChanged -= OnSectionChanged;
        SurfaceState.BlockChanged -= OnBlockChanged;

        _refreshDelay?.Cancel();
        _refreshDelay?.Dispose();

        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync(JS_DISPOSE);
                await _controller.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }

        _self?.Dispose();
    }
}
