@using IniaAi.Domain.Core.Interfaces
@using IniaAi.Domain.UserData.Interfaces
@using IniaAi.Domain.Entities.Workflows
@using IniaAi.Domain.Entities.Workflows.Enums
@using IniaAi.WebApp.Components.UserWorkflows.Common
@using IniaAi.Domain.Specifications.Workflows
@using IniaAi.Application.Queries.ExecutedWorkflows.DownloadExecutedWorkflow
@using Microsoft.EntityFrameworkCore
@using IniaAi.Domain.Entities.UserManagement
@using IniaAi.WebApp.Components.Components
@using IniaAi.WebApp.Components.UserWorkflows.Components
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@attribute [Route(AppRoutes.USER_WORKFLOWS)]
@attribute [Authorize(Roles = ROLES)]

@inject IDialogService DialogService
@inject IUserDataUnitOfWork UserDataUnitOfWork
@inject ICoreUnitOfWork CoreUnitOfWork
@inject IServiceScopeFactory ServiceScopeFactory
@inject NavigationManager Navigation
@inject ILogger<Workflows> Logger
@inject AppState AppState
@inject IJSRuntime JsRuntime

<PageTitle>Inia AI - @AppState.GetName(AppState.CurrentRoute)</PageTitle>

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudCard Outlined="true">
            <MudCardHeader>
                <MudText Typo="Typo.h5">
                    Workflow Management
                </MudText>
            </MudCardHeader>

            <MudCardContent>
                <MudSelect T="WorkflowType"
                           Label="Type Filter"
                           Variant="Variant.Outlined"
                           Value="_selectedType"
                           FullWidth="false"
                           Style="min-width: 200px"
                           ValueChanged="OnTypeChanged">
                    <MudSelectItem Value="@((WorkflowType?)null)">
                        All Types
                    </MudSelectItem>

                    @foreach (var type in _workflowTypes.OrderBy(x => x.Name))
                    {
                        <MudSelectItem Value="@type">
                            @type.Name
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="RefreshWorkflows"
                           Class="mb-4">
                    Refresh Workflows
                </MudButton>

                <AuthorizeView Roles="@(Roles.SUPER_ADMIN)">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               OnClick="ClearWorkflows"
                               Class="mb-4">
                        Clear Workflows
                    </MudButton>
                </AuthorizeView>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12">
        <WorkflowList Rows="_filteredRows"
                      OnDownload="DownloadWorkflow"
                      OnEdit="EditWorkflow"
                      OnDelete="DeleteWorkflow"
                      OnDeleteRun="DeleteRun"/>
    </MudItem>
</MudGrid>

@code {
    public const string ROLES = Roles.OPERATOR_ROLES;

    private WorkflowType? _selectedType;
    private List<WorkflowType> _workflowTypes = [];
    private List<Workflow> _workflows = [];
    private List<ExecutionOutcome> _outcomes = [];
    private IReadOnlyList<ExecutedWorkflowRow> _filteredRows = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflowTypesAsync();
        await LoadWorkflowsAsync();
    }

    private async Task LoadWorkflowTypesAsync()
    {
        try
        {
            var workflowTypes = await CoreUnitOfWork.WorkflowTypes.GetAllAsync();
            _workflowTypes = workflowTypes.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading workflow types");
            AppState.Notify("Failed to load workflow types", Severity.Error);
        }
    }

    private async Task LoadWorkflowsAsync()
    {
        try
        {
            var workflows = await UserDataUnitOfWork.Workflows.GetAllAsync();
            _workflows = workflows.OrderByDescending(w => w.CreatedAt).ToList();
            _outcomes = await LoadExecutionOutcomesAsync();

            foreach (var workflow in _workflows)
            {
                workflow.WorkflowType = _workflowTypes
                    .FirstOrDefault(wt => wt.Id == workflow.WorkflowTypeId);
        }

            // Initialize filtered workflows with all workflows
            FilterWorkflowsByType();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading workflows");
            AppState.Notify("Failed to load workflows", Severity.Error);
        }
    }

    private async Task<List<ExecutionOutcome>> LoadExecutionOutcomesAsync()
    {
        // WorkflowExecution has no foreign key to the snapshot it produced, so the outcome
        // columns are read once for every execution and joined in memory, never per row.
        return await UserDataUnitOfWork.WorkflowExecutions
            .GetAll()
            .AsNoTracking()
            .Where(e => e.WorkflowId != null)
            .Select(e => new ExecutionOutcome(
                e.Id,
                e.WorkflowId!,
                e.CreatedAt,
                e.WorkflowState,
                e.FailureKind,
                e.FailureDetail,
                e.WarningKind,
                e.WarningDetail,
                e.CompletedAt,
                e.Title,
                e.WorkflowTypeId))
            .ToListAsync();
    }

    private void FilterWorkflowsByType()
    {
        Dictionary<string, string> typeNamesById = _workflowTypes
            .DistinctBy(type => type.Id)
            .ToDictionary(type => type.Id, type => type.Name);

        _filteredRows = [.. ExecutedWorkflowRows.Build(_workflows, _outcomes, typeNamesById)
            .Where(row => _selectedType is null || row.WorkflowTypeId == _selectedType.Id)
            .OrderByDescending(row => row.CreatedAt)];
    }

    private async Task RefreshWorkflows()
    {
        await LoadWorkflowsAsync();
    }

    private async Task ClearWorkflows()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Clear Workflows",
            $"Delete all {_workflows.Count} executed workflows of every organization, whichever type is shown? This cannot be undone.",
            yesText: "Delete all",
            cancelText: "Cancel");

        if (confirmed is not true)
        {
            return;
        }

        try
        {
            foreach (var workflow in _workflows)
            {
                UserDataUnitOfWork.Workflows.Remove(workflow);
            }

            await UserDataUnitOfWork.CompleteAsync();
            _workflows.Clear();
            FilterWorkflowsByType();
            StateHasChanged();
            AppState.Notify("Workflows cleared successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing workflows");
            AppState.Notify("Failed to clear workflows", Severity.Error);
        }
    }

    private Task OnTypeChanged(WorkflowType? value)
    {
        _selectedType = value;
        FilterWorkflowsByType();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task EditWorkflow(Workflow workflow)
    {
        if (workflow is null)
        {
            return;
        }

        var parameters = new DialogParameters<WorkflowEditDialog>
        {
            { x => x.Workflow, workflow }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<WorkflowEditDialog>("Edit Workflow", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadWorkflowsAsync();
            StateHasChanged();
            AppState.Notify("Workflow updated successfully", Severity.Success);
        }
    }

    private async Task DeleteWorkflow(Workflow workflow)
    {
        if (workflow is null)
        {
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete workflow '{workflow.Name}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result is not true)
        {
            return;
        }

        try
        {
            UserDataUnitOfWork.Workflows.Remove(workflow);
            await UserDataUnitOfWork.CompleteAsync();
            _workflows.Remove(workflow);
            FilterWorkflowsByType();
            StateHasChanged();
            AppState.Notify($"Workflow '{workflow.Name}' deleted successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting workflow");
            AppState.Notify("Failed to delete workflow", Severity.Error);
        }
    }

    private async Task DeleteRun(ExecutionOutcome outcome)
    {
        string run = string.IsNullOrWhiteSpace(outcome.Title) ? "this run" : $"the run '{outcome.Title}'";
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete {run}? Its report is deleted with it.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result is not true)
        {
            return;
        }

        try
        {
            if (await UserDataUnitOfWork.WorkflowExecutions.GetByIdAsync(outcome.ExecutionId) is { } execution)
            {
                UserDataUnitOfWork.WorkflowExecutions.Remove(execution);
                await UserDataUnitOfWork.CompleteAsync();
            }

            _outcomes.Remove(outcome);
            FilterWorkflowsByType();
            StateHasChanged();
            AppState.Notify("Run deleted successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting run {ExecutionId}", outcome.ExecutionId);
            AppState.Notify("Failed to delete run", Severity.Error);
        }
    }

    private async Task DownloadWorkflow(Workflow workflow)
    {
        try
        {
            using IServiceScope scope = ServiceScopeFactory.CreateScope();
            IUserDataUnitOfWork unitOfWork = scope.ServiceProvider.GetRequiredService<IUserDataUnitOfWork>();

            Workflow? loadedWorkflow = await unitOfWork
                .Workflows
                .GetAll(new WorkflowExecutionDetailByIdSpec())
                .Where(x => x.Id == workflow.Id)
                .SingleOrDefaultAsync();

            if (loadedWorkflow is null)
            {
                AppState.Notify("Failed to download workflow", Severity.Error);

                return;
            }

            string json = await ExecutedWorkflowExport.ToJsonAsync(loadedWorkflow, unitOfWork, CancellationToken.None);

            var data = Encoding.UTF8.GetBytes(json);

            var filename = $"{loadedWorkflow.Name}.workflow";

            var streamRef = new DotNetStreamReference(new MemoryStream(data));
            await JsRuntime.InvokeVoidAsync("downloadFileFromStream", filename, streamRef);

            AppState.Notify(
                "Workflow downloaded successfully",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading workflow");
            AppState.Notify("Failed to download workflow", Severity.Error);
        }
    }
}
