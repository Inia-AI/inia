{
    "ServiceType": "admin",
    "ConnectionStrings": {
        "UserDataDbConnection": "",
        "CoreDbConnection": ""
    },
    "Authentication": {
        "Password": {
            "Enabled": true,
            "MaxFailedAccessAttempts": 5,
            "LockoutDurationMinutes": 15
        },
        "Google": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": "",
            "AllowedDomains": []
        },
        "Oidc": {
            "Enabled": false,
            "Issuer": "",
            "ClientId": "",
            "ClientSecret": "",
            "DisplayName": "SSO",
            "AllowedDomains": []
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore": "Information",
                "System": "Warning",
                "IniaAi": "Verbose",
                "IniaAi.WebApp.Services": "Warning",
                "IniaAi.Services.Messages": "Verbose",
                "IniaAi.Services.Jobs": "Verbose"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.log",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "PlatformSettings": {
        "UserDataDbProvider": "PostgreSQL",
        "CoreDbProvider": "PostgreSQL",
        "CustomerOrgId": "Default",
        "Anthropic": {
            "ApiKey": ""
        },
        "Cohere": {
            "ApiKey": ""
        },
        "Exa": {
            "ExaApiUrl": "https://api.exa.ai",
            "ApiKey": ""
        },
        "MessageProcessor": {
            "Directory": "monitoring"
        },
        "ModelRouting": {
            "DefaultModelFamily": "Anthropic"
        }
    },
    "FileStorage": {
        "DefaultProvider": "Database",
        "MinIO": {
            "Endpoint": "",
            "AccessKey": "",
            "SecretKey": "",
            "UseSSL": false,
            "Region": ""
        },
        "S3": {
            "Region": "",
            "AccessKeyId": "",
            "SecretAccessKey": "",
            "ServiceUrl": ""
        },
        "StorageBuckets": {
            "documents": "docs",
            "images": "imgs",
            "uploads": "uploads",
            "temp": "temp",
            "agent-session-bundles": "agent-session-bundles"
        },
        "TenantOverrides": {
        }
    }
}
