<Project Sdk="Microsoft.NET.Sdk">
    <!-- The PDFium worker process. PDFium is native code, and a crafted file can crash or hang it, so it runs only
         here, never in the server. The server starts it with its own runtime and dependency files, so the worker
         writes neither. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <UseAppHost>false</UseAppHost>
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <IsTestProject>false</IsTestProject>
        <RootNamespace>IniaAi.FileFormats.Pdf.Pdfium</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\IniaAi.FileFormats\Pdf\Pdfium\PdfiumWorkerProtocol.cs" Link="PdfiumWorkerProtocol.cs" />
        <Compile Include="..\IniaAi.FileFormats\Pdf\Pdfium\SeccompFilter.cs" Link="SeccompFilter.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="bblanchon.PDFium.Linux" />
        <PackageReference Include="bblanchon.PDFium.macOS" />
        <PackageReference Include="bblanchon.PDFium.Win32" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    </ItemGroup>
</Project>
