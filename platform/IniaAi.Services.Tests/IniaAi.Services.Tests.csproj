<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\IniaAi.Application\IniaAi.Application.csproj" />
        <ProjectReference Include="..\IniaAi.Common\IniaAi.Common.csproj" />
        <ProjectReference Include="..\IniaAi.Core.Tests\IniaAi.Core.Tests.csproj" />
        <ProjectReference Include="..\IniaAi.FileFormats.ContractTests\IniaAi.FileFormats.ContractTests.csproj" />
        <ProjectReference Include="..\IniaAi.Services\IniaAi.Services.csproj" />
        <ProjectReference Include="..\IniaAi.Testing.DependencyInjection\IniaAi.Testing.DependencyInjection.csproj" />
        <ProjectReference Include="..\IniaAi.Testing.Documents\IniaAi.Testing.Documents.csproj" />
        <ProjectReference Include="..\IniaAi.Testing\IniaAi.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <None Update="TestResources\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="FixSeleniumManagerPermissions"
            AfterTargets="Build"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $([MSBuild]::IsOSPlatform('Linux'))">
        <Exec Command="chmod +x &quot;$(OutputPath)runtimes/osx/native/selenium-manager&quot;"
              Condition="Exists('$(OutputPath)runtimes/osx/native/selenium-manager')"
              IgnoreExitCode="true" />

        <Exec Command="chmod +x &quot;$(OutputPath)runtimes/linux/native/selenium-manager&quot;"
              Condition="Exists('$(OutputPath)runtimes/linux/native/selenium-manager')"
              IgnoreExitCode="true" />
    </Target>
</Project>
