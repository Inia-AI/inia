{
    "ServiceType": "api",
    "ConnectionStrings": {
        "UserDataDbConnection": "",
        "CoreDbConnection": ""
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore": "Information",
                "System": "Warning",
                "IniaAi": "Verbose",
                "IniaAi.WebApp.Services": "Warning",
                "IniaAi.Services.Messages": "Verbose",
                "IniaAi.Services.Jobs": "Verbose"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.log",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "PlatformSettings": {
        "UserDataDbProvider": "PostgreSQL",
        "CoreDbProvider": "PostgreSQL",
        "CustomerOrgId": "Default",
        "UseLlmForRegressionComparison": true,
        "Anthropic": {
            "ApiKey": ""
        },
        "Cohere": {
            "ApiKey": ""
        },
        "Exa": {
            "ExaApiUrl": "https://api.exa.ai",
            "ApiKey": ""
        },
        "ModelRouting": {
            "DefaultModelFamily": "Anthropic"
        },
        "ChartRendering": {
            "RenderTimeoutMs": 10000
        }
    },
    "Jwt": {
        "Issuer": "http://localhost",
        "TokenValidityInMinutes": 1000
    },
    "EmailSettings": {
        "Provider": ""
    },
    "SendGrid": {
        "ApiKey": "",
        "FromEmail": "",
        "FromName": ""
    },
    "Smtp": {
        "Host": "",
        "Port": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": "",
        "FromEmail": "",
        "FromName": ""
    },
    "Swagger": {
        "TokenUrl": "/api/v1/connect/token"
    },
    "FileStorage": {
        "DefaultProvider": "Database",
        "MinIO": {
            "Endpoint": "",
            "AccessKey": "",
            "SecretKey": "",
            "UseSSL": false,
            "Region": ""
        },
        "S3": {
            "Region": "",
            "AccessKeyId": "",
            "SecretAccessKey": "",
            "ServiceUrl": ""
        },
        "StorageBuckets": {
            "documents": "docs",
            "images": "imgs",
            "uploads": "uploads",
            "temp": "temp",
            "agent-session-bundles": "agent-session-bundles"
        },
        "TenantOverrides": {
        }
    },
    "TwoFactor": {
        "MfaTokenValidityMinutes": 5,
        "TrustedDeviceDays": 30,
        "RecoveryCodeCount": 10,
        "EnforceIpValidation": false,
        "EmailOtp": {
            "CooldownSeconds": 60
        }
    },
    "DataProtection": {
        "Provider": "database",
        "AzureKeyVault": {
            "KeyUri": ""
        },
        "AwsSsm": {
            "ParameterPath": "/iniaai/dataprotection/keys",
            "KmsKeyId": ""
        }
    },
    "Authentication": {
        "Password": {
            "Enabled": true,
            "MaxFailedAccessAttempts": 5,
            "LockoutDurationMinutes": 15
        },
        "Google": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": "",
            "AllowedDomains": []
        }
    }
}
