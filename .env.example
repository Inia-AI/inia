# Copy this file to .env beside compose.yaml and fill in the first two values. Docker Compose reads
# .env on its own, and git ignores it. Put a value that holds a $ in single quotes, or Compose reads
# the $ as the start of a variable. After you change a value, run
# `docker compose up --wait --force-recreate`, or the running services keep the old one.

# Required. The Anthropic API key every model call uses.
ANTHROPIC_API_KEY=
# Required. The password of the first admin: at least 8 characters, with an
# uppercase letter, a lowercase letter and a digit. The first start sets it; later starts keep the
# password the account has.
INIA_ADMIN_PASSWORD=
# Optional. The first admin's address. The first start creates the account; later starts keep it.
#INIA_ADMIN_EMAIL=superadmin@example.com

# Optional keys. Each turns on what platform/README.md says it adds.
COHERE_API_KEY=
EXA_API_KEY=
EXCHANGE_RATE_API_KEY=

# Optional. Where the stack listens. Set INIA_BIND_ADDRESS to 0.0.0.0 only behind a TLS proxy:
# the stack serves plain HTTP.
#INIA_BIND_ADDRESS=127.0.0.1
#INIA_WEB_PORT=8080
#INIA_ADMIN_PORT=8081

# The release number the apps show, such as 2.2.12. Each release of this repository fills it in.
# Without it, the apps show 0.0.0.0 and the Vue app leaves out its own version line.
INIA_VERSION=2.2.18
